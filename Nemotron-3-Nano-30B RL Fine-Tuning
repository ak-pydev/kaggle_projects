    "from datetime import datetime, timezone\n",
    "\n",
    "# ── Hub helpers ──────────────────────────────────────────────────────────────\n",
    "def _hub_upload(local_path: str, repo_path: str, cfg) -> bool:\n",
    "    if not cfg.hub_model_id:\n",
    "        return False\n",
    "    try:\n",
    "        from huggingface_hub import upload_file\n",
    "        upload_file(\n",
    "            path_or_fileobj=local_path,\n",
    "            path_in_repo=repo_path,\n",
    "            repo_id=cfg.hub_model_id,\n",
    "            commit_message=f'auto: {repo_path}',\n",
    "        )\n",
    "        return True\n",
    "    except Exception as e:\n",
    "        print(f'[hub] upload failed ({repo_path}): {e}')\n",
    "        return False\n",
    "\n",
    "def _hub_download(repo_path: str, cfg) -> Optional[str]:\n",
    "    if not cfg.hub_model_id or not cfg.resume_from_hub:\n",
    "        return None\n",
    "    try:\n",
    "        from huggingface_hub import hf_hub_download\n",
    "        return hf_hub_download(cfg.hub_model_id, repo_path)\n",
    "    except Exception:\n",
    "        return None\n",
    "\n",
    "# ── Stage tracking ───────────────────────────────────────────────────────────\n",
    "_STAGES_LOCAL = Path(CFG.output_dir) / 'stages.json'\n",
    "\n",
    "def _load_stages() -> dict:\n",
    "    if _STAGES_LOCAL.exists():\n",
    "        with open(_STAGES_LOCAL) as f:\n",
    "            return json.load(f)\n",
    "    local = _hub_download('stages.json', CFG)\n",
    "    if local:\n",
    "        with open(local) as f:\n",
    "            return json.load(f)\n",
    "    return {}\n",
    "\n",
    "def mark_stage_done(stage: str):\n",
    "    stages = _load_stages()\n",
    "    stages[stage] = {'completed': True, 'ts': datetime.now(timezone.utc).isoformat()}\n",
    "    _STAGES_LOCAL.parent.mkdir(parents=True, exist_ok=True)\n",
    "    with open(_STAGES_LOCAL, 'w') as f:\n",
    "        json.dump(stages, f, indent=2)\n",
    "    _hub_upload(str(_STAGES_LOCAL), 'stages.json', CFG)\n",
    "    print(f'[stage] \"{stage}\" marked complete.')\n",
    "\n",
    "def is_stage_done(stage: str) -> bool:\n",
    "    return _load_stages().get(stage, {}).get('completed', False)\n",
    "\n",
    "# ── Checkpoint resume ─────────────────────────────────────────────────────────\n",
    "def _latest_local_ckpt(directory: str) -> Optional[str]:\n",
    "    d = Path(directory)\n",
    "    if not d.exists():\n",
    "        return None\n",
    "    ckpts = sorted(\n",
    "        [x for x in d.iterdir() if x.is_dir() and x.name.startswith('checkpoint-')],\n",
    "        key=lambda x: int(x.name.split('-')[-1]),\n",
    "    )\n",
    "    return str(ckpts[-1]) if ckpts else None\n",
    "\n",
    "def pull_and_resume(stage_dir: str, cfg) -> Optional[str]:\n",
    "    # Return path to the latest checkpoint for a stage, pulling from Hub if needed.\n",
    "    local_ckpt = _latest_local_ckpt(stage_dir)\n",
    "    if local_ckpt:\n",

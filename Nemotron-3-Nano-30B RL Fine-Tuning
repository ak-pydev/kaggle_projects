   "source": [
    "def eval_math500(model, tokenizer, n_problems: int = 200, max_new_tokens: int = 512, seed: int = 42) -> float:\n",
    "    # Evaluate on a random sample from the hendrycks/competition_math test split.\n",
    "    # This is the standard MATH benchmark used to measure competition-math progress.\n",
    "    print(f'Loading MATH benchmark (test split, {n_problems} problems) ...')\n",
    "    try:\n",
    "        bench_ds = load_dataset('hendrycks/competition_math', split='test', trust_remote_code=True)\n",
    "    except Exception as e:\n",
    "        print(f'Could not load MATH benchmark: {e}')\n",
    "        return float('nan')\n",
    "\n",
    "    import random as _random\n",
    "    rng = _random.Random(seed)\n",
    "    indices = rng.sample(range(len(bench_ds)), min(n_problems, len(bench_ds)))\n",
    "    problems = []\n",
    "    for i in indices:\n",
    "        row = bench_ds[i]\n",
    "        ans = extract_answer(row.get('solution', ''))\n",
    "        if ans:\n",
    "            problems.append({'problem': row['problem'], 'answer': ans})\n",
    "\n",
    "    if not problems:\n",
    "        print('No valid benchmark problems found.')\n",
    "        return float('nan')\n",
    "\n",
    "    print(f'Running MATH benchmark on {len(problems)} problems ...')\n",
    "    return quick_eval(model, tokenizer, problems, max_new_tokens=max_new_tokens)\n",
    "\n",
    "\n",
    "# Run the benchmark — set n_problems lower if you want a quick sanity check\n",
    "eval_math500(MODEL, TOKENIZER, n_problems=200)\n"
   ]
  },

    "        output_dir / 'dpo_stage' / 'trainer_state.json',\n",
    "        output_dir / 'grpo_stage' / 'trainer_state.json',\n",
    "    ]\n",
    "    for path in candidate_paths:\n",
    "        if not path.exists():\n",
    "            print(f'No trainer_state.json found at {path}')\n",
    "            continue\n",
    "        payload = json.loads(path.read_text())\n",
    "        log_history = payload.get('log_history', [])\n",
    "        losses = [entry['loss'] for entry in log_history if 'loss' in entry]\n",
    "        steps = [entry['step'] for entry in log_history if 'loss' in entry]\n",
    "        print(f'Log file: {path}')\n",
    "        print(f'Logged loss points: {len(losses)}')\n",
    "        if losses:\n",
    "            print(f'Loss start={losses[0]:.4f} end={losses[-1]:.4f} min={min(losses):.4f}')\n",
    "            print(f'Last step={steps[-1]}')\n",
    "\n",
    "\n",
    "parse_trainer_logs(CFG.output_dir)\n"

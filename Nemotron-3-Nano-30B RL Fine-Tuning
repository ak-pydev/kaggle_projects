{"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.10.0"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceType":"competition","sourceId":129716,"databundleVersionId":16082784}],"dockerImageVersionId":31329,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":true}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"markdown","source":"# Nemotron-3-Nano-30B RL Fine-Tuning\n## Strategy: Curriculum RL + PRM Reward + Format-Aware Reward Shaping via GRPO\n\n### Pipeline Overview\n1. **Data loading** — NuminaMath + MATH dataset with difficulty bucketing\n2. **Curriculum scheduler** — promotes problems dynamically based on live solve-rate\n3. **Reward functions** — correctness + step-level PRM + format compliance\n4. **GRPO training** — with LoRA rank=32 on Nemotron-3-Nano-30B\n5. **Submission packaging** — zips adapter + config for direct Kaggle submission\n\n> **Kaggle setup**: Use a GPU T4 x2 or P100 accelerator. Set `KAGGLE_MODEL_PATH` secret if pulling from Kaggle Models.","metadata":{}},{"cell_type":"markdown","source":"## Install dependencies","metadata":{}},{"cell_type":"code","source":"import subprocess, sys\n\ndef pip(*args):\n    subprocess.check_call([sys.executable, '-m', 'pip', 'install', '-q', *args])\n\npip('torch==2.2.2', '--index-url', 'https://download.pytorch.org/whl/cu121')\npip('transformers==4.44.2')\npip('peft==0.12.0')\npip('trl==0.10.1')\npip('accelerate==0.34.2')\npip('datasets==2.21.0')\npip('bitsandbytes==0.43.3')\npip('sentencepiece')\npip('math_verify')  # NVIDIA's official answer extractor — mirrors the eval metric\n\nprint('All packages installed.')","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Imports & config","metadata":{}},{"cell_type":"code","source":"import os, re, json, math, random, zipfile, warnings\nfrom pathlib import Path\nfrom dataclasses import dataclass, field\nfrom typing import List, Dict, Optional, Tuple\nfrom collections import defaultdict\n\nimport torch\nimport numpy as np\nfrom datasets import load_dataset, Dataset, concatenate_datasets\nfrom transformers import (\n    AutoTokenizer,\n    AutoModelForCausalLM,\n    BitsAndBytesConfig,\n    TrainerCallback,\n)\nfrom peft import LoraConfig, get_peft_model, TaskType, PeftModel\nfrom trl import GRPOConfig, GRPOTrainer\n\nwarnings.filterwarnings('ignore')\ntorch.manual_seed(42)\nrandom.seed(42)\nnp.random.seed(42)\n\n# ─── Master config ────────────────────────────────────────────────────────────\n@dataclass\nclass Config:\n    # Model\n    model_id: str             = 'nvidia/Nemotron-3-Nano-30B'  # HF hub id\n    model_local: str          = '/kaggle/input/nemotron-nano-30b'  # or None\n\n    # LoRA\n    lora_rank: int            = 32\n    lora_alpha: int           = 64\n    lora_dropout: float       = 0.05\n    target_modules: List[str] = field(default_factory=lambda: [\n        'q_proj', 'k_proj', 'v_proj', 'o_proj',\n        'gate_proj', 'up_proj', 'down_proj'\n    ])\n\n    # Data\n    max_samples: int          = 8000   # total training examples (tune up if time allows)\n    max_prompt_len: int       = 512\n    max_completion_len: int   = 1024\n    num_difficulty_buckets: int = 5\n    promote_threshold: float  = 0.70   # promote bucket when solve-rate >= this\n\n    # GRPO\n    num_generations: int      = 8      # rollouts per prompt (G in GRPO)\n    learning_rate: float      = 5e-6\n    per_device_train_batch_size: int = 1\n    gradient_accumulation_steps: int = 8\n    num_train_epochs: int     = 2\n    max_grad_norm: float      = 0.5\n    warmup_ratio: float       = 0.05\n    save_steps: int           = 50\n\n    # Rewards\n    reward_correct: float     = 1.0\n    reward_format_box: float  = 0.15   # bonus for \\boxed{} present\n    reward_format_int: float  = 0.10   # bonus for integer answer when expected\n    reward_repetition: float  = -0.20  # penalty for repeated phrases\n    reward_prm_weight: float  = 0.30   # weight of PRM signal\n\n    # Output\n    output_dir: str           = '/kaggle/working/nemotron_lora'\n    submission_zip: str       = '/kaggle/working/submission.zip'\n\nCFG = Config()\nprint(json.dumps(CFG.__dict__, indent=2, default=str))","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## System prompt (matches eval format exactly)","metadata":{}},{"cell_type":"code","source":"SYSTEM_PROMPT = \"\"\"You are an expert mathematical reasoning assistant.\nSolve each problem step by step using clear logical reasoning.\nAlways place your final answer inside \\\\boxed{} at the end of your response.\n\nRules:\n- Show all intermediate steps clearly\n- Do not repeat yourself\n- Simplify your final answer as much as possible\n- Put ONLY the final answer inside \\\\boxed{}, nothing else\n\"\"\"\n\ndef make_prompt(problem: str, tokenizer) -> str:\n    \"\"\"Format a problem using the model's chat template.\"\"\"\n    messages = [\n        {'role': 'system', 'content': SYSTEM_PROMPT},\n        {'role': 'user',   'content': problem.strip()},\n    ]\n    return tokenizer.apply_chat_template(\n        messages,\n        tokenize=False,\n        add_generation_prompt=True\n    )\n\nprint('System prompt ready.')","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Answer extraction (mirrors NVIDIA eval metric)","metadata":{}},{"cell_type":"code","source":"def extract_boxed(text: str) -> Optional[str]:\n    \"\"\"Extract content from \\\\boxed{...}, handling nested braces.\"\"\"\n    idx = text.rfind(r'\\boxed{')\n    if idx == -1:\n        return None\n    start = idx + len(r'\\boxed{')\n    depth, end = 1, start\n    while end < len(text) and depth > 0:\n        if text[end] == '{':\n            depth += 1\n        elif text[end] == '}':\n            depth -= 1\n        end += 1\n    return text[start:end-1].strip() if depth == 0 else None\n\n\ndef extract_last_number(text: str) -> Optional[str]:\n    \"\"\"Fallback: grab the last numeric value in the text.\"\"\"\n    nums = re.findall(r'-?\\d+\\.?\\d*', text)\n    return nums[-1] if nums else None\n\n\ndef extract_answer(text: str) -> Optional[str]:\n    \"\"\"Full extraction pipeline matching the Kaggle metric.\"\"\"\n    ans = extract_boxed(text)\n    if ans:\n        return ans\n    # heuristic: last sentence after 'answer is', 'therefore', '='\n    for pattern in [r'(?:answer is|therefore)[:\\s]+([^\\n.]+)', r'=\\s*([^\\n=]+)$']:\n        m = re.search(pattern, text, re.IGNORECASE)\n        if m:\n            return m.group(1).strip()\n    return extract_last_number(text)\n\n\ndef answers_match(pred: Optional[str], gold: str, tol: float = 1e-6) -> bool:\n    \"\"\"Exact string match or numeric match within tolerance.\"\"\"\n    if pred is None:\n        return False\n    pred, gold = pred.strip(), gold.strip()\n    if pred == gold:\n        return True\n    try:\n        return abs(float(pred) - float(gold)) / max(abs(float(gold)), 1e-9) < tol\n    except (ValueError, ZeroDivisionError):\n        return False\n\n\n# Quick smoke tests\nassert extract_boxed(r'The answer is \\boxed{42}') == '42'\nassert extract_boxed(r'\\boxed{\\frac{1}{2}}') == r'\\frac{1}{2}'\nassert answers_match('42', '42.0000001')\nprint('Answer extraction OK.')","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Data loading + difficulty bucketing","metadata":{}},{"cell_type":"code","source":"def load_and_bucket_data(cfg: Config) -> List[Dict]:\n    \"\"\"\n    Load NuminaMath + MATH, tag each example with a difficulty bucket 0-4.\n    Difficulty proxy: token length of the solution (longer ≈ harder).\n    \"\"\"\n    all_examples = []\n\n    # ── NuminaMath-CoT ────────────────────────────────────────────────────────\n    print('Loading NuminaMath-CoT...')\n    try:\n        numina = load_dataset('AI-MO/NuminaMath-CoT', split='train')\n        for ex in numina:\n            prob = ex.get('problem') or ex.get('question', '')\n            sol  = ex.get('solution') or ex.get('answer', '')\n            ans  = extract_boxed(sol) or extract_last_number(sol)\n            if prob and ans:\n                all_examples.append({\n                    'problem':    prob,\n                    'solution':   sol,\n                    'answer':     ans,\n                    'source':     'numina',\n                    'sol_len':    len(sol),\n                })\n    except Exception as e:\n        print(f'  NuminaMath load failed: {e}')\n\n    # ── MATH (Hendrycks) ──────────────────────────────────────────────────────\n    print('Loading MATH dataset...')\n    try:\n        math_ds = load_dataset('lighteval/MATH', 'all', split='train', trust_remote_code=True)\n        for ex in math_ds:\n            prob = ex.get('problem', '')\n            sol  = ex.get('solution', '')\n            ans  = extract_boxed(sol)\n            if prob and ans:\n                all_examples.append({\n                    'problem':  prob,\n                    'solution': sol,\n                    'answer':   ans,\n                    'source':   'math',\n                    'sol_len':  len(sol),\n                    'level':    ex.get('level', ''),\n                })\n    except Exception as e:\n        print(f'  MATH load failed: {e}')\n\n    print(f'Total raw examples: {len(all_examples)}')\n\n    # ── Shuffle & cap ─────────────────────────────────────────────────────────\n    random.shuffle(all_examples)\n    all_examples = all_examples[:cfg.max_samples]\n\n    # ── Assign difficulty buckets (0=easiest, 4=hardest) by solution length ──\n    sol_lens = [ex['sol_len'] for ex in all_examples]\n    percentiles = np.percentile(sol_lens, [20, 40, 60, 80])\n\n    def get_bucket(length: int) -> int:\n        for i, p in enumerate(percentiles):\n            if length <= p:\n                return i\n        return 4\n\n    # Override with explicit level tags when available (MATH dataset)\n    level_map = {'Level 1': 0, 'Level 2': 1, 'Level 3': 2, 'Level 4': 3, 'Level 5': 4}\n    for ex in all_examples:\n        lvl = ex.get('level', '')\n        ex['difficulty'] = level_map.get(lvl, get_bucket(ex['sol_len']))\n\n    # Stats\n    bucket_counts = defaultdict(int)\n    for ex in all_examples:\n        bucket_counts[ex['difficulty']] += 1\n    print('Difficulty distribution:', dict(sorted(bucket_counts.items())))\n    return all_examples\n\nEXAMPLES = load_and_bucket_data(CFG)\nprint(f'Dataset ready: {len(EXAMPLES)} examples')","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Curriculum scheduler","metadata":{}},{"cell_type":"code","source":"class CurriculumScheduler:\n    \"\"\"\n    Tracks per-bucket solve-rates and gates access to harder buckets.\n    Starts at bucket 0 only; promotes when solve-rate >= promote_threshold.\n    \"\"\"\n\n    def __init__(self, examples: List[Dict], cfg: Config):\n        self.cfg = cfg\n        self.threshold = cfg.promote_threshold\n        self.max_bucket = cfg.num_difficulty_buckets - 1\n\n        # Organise examples by bucket\n        self.buckets: Dict[int, List[Dict]] = defaultdict(list)\n        for ex in examples:\n            self.buckets[ex['difficulty']].append(ex)\n\n        self.active_max  = 0                # highest unlocked bucket\n        self.solve_counts = defaultdict(lambda: [0, 0])  # bucket -> [correct, total]\n\n    def sample_batch(self, n: int) -> List[Dict]:\n        \"\"\"Sample n examples from unlocked buckets, weighted toward harder ones.\"\"\"\n        pool = []\n        for b in range(self.active_max + 1):\n            pool.extend(self.buckets.get(b, []))\n        if not pool:\n            pool = self.buckets[0]\n        return random.choices(pool, k=n)\n\n    def record(self, bucket: int, correct: bool):\n        \"\"\"Update solve-rate tracking and promote if threshold met.\"\"\"\n        self.solve_counts[bucket][1] += 1\n        if correct:\n            self.solve_counts[bucket][0] += 1\n\n        # Check promotion (require at least 20 samples before evaluating)\n        correct_n, total_n = self.solve_counts[self.active_max]\n        if total_n >= 20 and self.active_max < self.max_bucket:\n            rate = correct_n / total_n\n            if rate >= self.threshold:\n                self.active_max += 1\n                print(f'  [Curriculum] Promoted to bucket {self.active_max} '\n                      f'(solve-rate was {rate:.2%})')\n                self.solve_counts[self.active_max - 1] = [0, 0]  # reset after promote\n\n    def status(self) -> str:\n        lines = []\n        for b in range(self.active_max + 1):\n            c, t = self.solve_counts[b]\n            rate = c/t if t else 0\n            lines.append(f'  Bucket {b}: {c}/{t} = {rate:.1%}')\n        return '\\n'.join(lines)\n\n\nCURRICULUM = CurriculumScheduler(EXAMPLES, CFG)\nprint('Curriculum scheduler ready.')\nprint(f'Initial bucket pool size: {len(CURRICULUM.buckets[0])}')","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Reward functions","metadata":{}},{"cell_type":"code","source":"# ─── PRM: lightweight step scorer ────────────────────────────────────────────\n# We approximate a PRM without training a separate model:\n# 1. Split completion into reasoning steps (by newline / sentence)\n# 2. Check each step for red flags: contradictions, repetition, unsupported leaps\n# 3. Return a normalised score in [0, 1]\n\ndef prm_step_score(completion: str) -> float:\n    \"\"\"\n    Lightweight heuristic PRM.\n    Penalises: repetition, very short steps, no intermediate workings.\n    Rewards: equation-like steps, explicit \"therefore\" / \"so\" connectors.\n    \"\"\"\n    steps = [s.strip() for s in re.split(r'\\n+|(?<=[.!?])\\s+', completion) if s.strip()]\n    if not steps:\n        return 0.0\n\n    score = 0.0\n    seen_steps = set()\n\n    for step in steps:\n        step_score = 0.5  # baseline\n\n        # Reward: has math / equation\n        if re.search(r'[=+\\-*/^]|\\\\frac|\\\\sqrt', step):\n            step_score += 0.2\n\n        # Reward: logical connectors\n        if re.search(r'\\b(therefore|thus|so|hence|because|since|we get|gives us)\\b',\n                     step, re.I):\n            step_score += 0.15\n\n        # Penalise: very short (likely filler)\n        if len(step.split()) < 4:\n            step_score -= 0.2\n\n        # Penalise: repetition\n        step_key = ' '.join(step.lower().split()[:8])\n        if step_key in seen_steps:\n            step_score -= 0.4\n        seen_steps.add(step_key)\n\n        score += max(0.0, min(1.0, step_score))\n\n    return score / len(steps)\n\n\n# ─── Format reward ────────────────────────────────────────────────────────────\ndef format_reward(completion: str, gold_answer: str) -> float:\n    \"\"\"Sub-rewards for formatting compliance, independent of correctness.\"\"\"\n    r = 0.0\n\n    # Bonus: \\boxed{} present\n    if r'\\boxed{' in completion:\n        r += CFG.reward_format_box\n\n    # Bonus: integer answer when gold is integer\n    boxed = extract_boxed(completion)\n    if boxed:\n        try:\n            float(gold_answer)  # gold is numeric\n            if float(gold_answer) == int(float(gold_answer)):  # gold is integer\n                try:\n                    if float(boxed) == int(float(boxed)):      # pred is also integer\n                        r += CFG.reward_format_int\n                except ValueError:\n                    pass\n        except ValueError:\n            pass\n\n    # Penalty: repetition in the completion\n    words = completion.lower().split()\n    if len(words) > 20:\n        bigrams = [f'{words[i]} {words[i+1]}' for i in range(len(words)-1)]\n        unique_ratio = len(set(bigrams)) / len(bigrams)\n        if unique_ratio < 0.6:  # more than 40% repeated bigrams\n            r += CFG.reward_repetition\n\n    return r\n\n\n# ─── Master reward function (called by GRPOTrainer) ───────────────────────────\ndef compute_reward(\n    completions: List[str],\n    gold_answers: List[str],\n    difficulty_buckets: List[int],\n) -> List[float]:\n    \"\"\"\n    For each (completion, gold_answer) pair, compute:\n        reward = correctness + PRM * weight + format_rewards\n    Also updates the curriculum scheduler.\n    \"\"\"\n    rewards = []\n    for completion, gold, bucket in zip(completions, gold_answers, difficulty_buckets):\n        pred  = extract_answer(completion)\n        is_correct = answers_match(pred, gold)\n\n        # Correctness reward\n        r = CFG.reward_correct if is_correct else 0.0\n\n        # PRM reward (weighted)\n        r += CFG.reward_prm_weight * prm_step_score(completion)\n\n        # Format reward\n        r += format_reward(completion, gold)\n\n        rewards.append(r)\n        CURRICULUM.record(bucket, is_correct)\n\n    return rewards\n\n\n# ─── Smoke test ───────────────────────────────────────────────────────────────\ntest_comp = r'We compute: 3 + 4 = 7. Therefore the answer is \\boxed{7}.'\ntest_rewards = compute_reward([test_comp], ['7'], [0])\nprint(f'Test reward for correct answer: {test_rewards[0]:.3f}')  # expect ~1.55\n\ntest_wrong = r'The answer is \\boxed{5}.'\ntest_rewards2 = compute_reward([test_wrong], ['7'], [0])\nprint(f'Test reward for wrong answer:   {test_rewards2[0]:.3f}')  # expect ~0.3","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Load model + apply LoRA","metadata":{}},{"cell_type":"code","source":"def load_model_and_tokenizer(cfg: Config):\n    model_path = cfg.model_local if (cfg.model_local and Path(cfg.model_local).exists()) \\\n                 else cfg.model_id\n    print(f'Loading from: {model_path}')\n\n    tokenizer = AutoTokenizer.from_pretrained(\n        model_path,\n        use_fast=True,\n        padding_side='left',\n    )\n    if tokenizer.pad_token is None:\n        tokenizer.pad_token = tokenizer.eos_token\n\n    bnb_config = BitsAndBytesConfig(\n        load_in_4bit=True,\n        bnb_4bit_quant_type='nf4',\n        bnb_4bit_use_double_quant=True,\n        bnb_4bit_compute_dtype=torch.bfloat16,\n    )\n\n    model = AutoModelForCausalLM.from_pretrained(\n        model_path,\n        quantization_config=bnb_config,\n        device_map='auto',\n        torch_dtype=torch.bfloat16,\n        trust_remote_code=True,\n    )\n    model.config.use_cache = False\n    model.enable_input_require_grads()\n\n    # Apply LoRA\n    lora_cfg = LoraConfig(\n        r=cfg.lora_rank,\n        lora_alpha=cfg.lora_alpha,\n        target_modules=cfg.target_modules,\n        lora_dropout=cfg.lora_dropout,\n        bias='none',\n        task_type=TaskType.CAUSAL_LM,\n    )\n    model = get_peft_model(model, lora_cfg)\n    model.print_trainable_parameters()\n\n    return model, tokenizer\n\n\nMODEL, TOKENIZER = load_model_and_tokenizer(CFG)\nprint('Model + LoRA ready.')","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Build HuggingFace dataset with curriculum-aware sampling","metadata":{}},{"cell_type":"code","source":"def build_hf_dataset(examples: List[Dict], tokenizer, cfg: Config) -> Dataset:\n    \"\"\"\n    Convert raw examples into the format GRPOTrainer expects.\n    Each row: { 'prompt': str, 'answer': str, 'difficulty': int }\n    \"\"\"\n    rows = []\n    for ex in examples:\n        prompt = make_prompt(ex['problem'], tokenizer)\n\n        # Token length guard\n        toks = tokenizer(prompt, return_tensors='pt')\n        if toks['input_ids'].shape[1] > cfg.max_prompt_len:\n            continue\n\n        rows.append({\n            'prompt':     prompt,\n            'answer':     ex['answer'],\n            'difficulty': ex['difficulty'],\n        })\n\n    ds = Dataset.from_list(rows)\n    print(f'HF dataset: {len(ds)} rows after length filtering')\n    return ds\n\n\nTRAIN_DS = build_hf_dataset(EXAMPLES, TOKENIZER, CFG)","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Curriculum callback + GRPO reward wrapper","metadata":{}},{"cell_type":"code","source":"class CurriculumCallback(TrainerCallback):\n    \"\"\"Logs curriculum status after every eval step.\"\"\"\n\n    def on_evaluate(self, args, state, control, **kwargs):\n        print(f'\\n[Step {state.global_step}] Curriculum status:\\n{CURRICULUM.status()}')\n        print(f'  Active max bucket: {CURRICULUM.active_max}')\n\n\n# GRPOTrainer expects the reward fn signature:\n#   fn(prompts, completions, **batch_columns) -> List[float]\n# We pass 'answer' and 'difficulty' as extra columns from the dataset.\n\ndef grpo_reward_fn(\n    prompts: List[str],\n    completions: List[str],\n    answer: List[str] = None,\n    difficulty: List[int] = None,\n    **kwargs\n) -> List[float]:\n    if answer is None:\n        answer = [''] * len(completions)\n    if difficulty is None:\n        difficulty = [0] * len(completions)\n    return compute_reward(completions, answer, difficulty)\n\n\nprint('Reward wrapper ready.')","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## GRPO training","metadata":{}},{"cell_type":"code","source":"grpo_config = GRPOConfig(\n    # Core GRPO params\n    num_generations=CFG.num_generations,\n    max_prompt_length=CFG.max_prompt_len,\n    max_completion_length=CFG.max_completion_len,\n\n    # Optimiser\n    learning_rate=CFG.learning_rate,\n    per_device_train_batch_size=CFG.per_device_train_batch_size,\n    gradient_accumulation_steps=CFG.gradient_accumulation_steps,\n    num_train_epochs=CFG.num_train_epochs,\n    max_grad_norm=CFG.max_grad_norm,\n    warmup_ratio=CFG.warmup_ratio,\n    lr_scheduler_type='cosine',\n    optim='paged_adamw_8bit',\n\n    # Generation (must be deterministic during training rollouts)\n    temperature=0.9,      # exploratory during GRPO rollouts\n    top_p=0.95,\n    do_sample=True,\n\n    # Logging & saving\n    output_dir=CFG.output_dir,\n    save_steps=CFG.save_steps,\n    logging_steps=10,\n    report_to='none',\n    bf16=True,\n    gradient_checkpointing=True,\n    remove_unused_columns=False,  # keep 'answer' and 'difficulty' columns\n    dataloader_num_workers=0,\n)\n\ntrainer = GRPOTrainer(\n    model=MODEL,\n    args=grpo_config,\n    reward_funcs=[grpo_reward_fn],\n    train_dataset=TRAIN_DS,\n    tokenizer=TOKENIZER,\n    callbacks=[CurriculumCallback()],\n)\n\nprint('Starting GRPO training...')\ntrainer.train()\nprint('Training complete.')","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Save LoRA adapter","metadata":{}},{"cell_type":"code","source":"out = Path(CFG.output_dir)\nout.mkdir(parents=True, exist_ok=True)\n\nMODEL.save_pretrained(str(out))\nTOKENIZER.save_pretrained(str(out))\n\n# Verify required file exists\ncfg_path = out / 'adapter_config.json'\nassert cfg_path.exists(), 'adapter_config.json missing!'\n\n# Patch adapter_config to ensure base_model_name_or_path is correct\nwith open(cfg_path) as f:\n    adapter_cfg = json.load(f)\nadapter_cfg['base_model_name_or_path'] = 'nvidia/Nemotron-3-Nano-30B'\nwith open(cfg_path, 'w') as f:\n    json.dump(adapter_cfg, f, indent=2)\n\nprint('Adapter saved.')\nprint('Files:', [p.name for p in out.iterdir()])","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Quick local evaluation","metadata":{}},{"cell_type":"code","source":"EVAL_PROBLEMS = [\n    {'problem': 'What is 15% of 200?', 'answer': '30'},\n    {'problem': 'Solve for x: 2x + 5 = 17', 'answer': '6'},\n    {'problem': 'What is the sum of the first 10 positive integers?', 'answer': '55'},\n    {'problem': 'A rectangle has length 12 and width 7. What is its area?', 'answer': '84'},\n    {'problem': r'Simplify: $\\frac{3}{4} + \\frac{1}{6}$', 'answer': r'\\frac{11}{12}'},\n]\n\ndef quick_eval(model, tokenizer, problems: List[Dict], max_new_tokens: int = 512) -> float:\n    model.eval()\n    correct = 0\n    with torch.no_grad():\n        for ex in problems:\n            prompt = make_prompt(ex['problem'], tokenizer)\n            inputs = tokenizer(prompt, return_tensors='pt').to(model.device)\n            outputs = model.generate(\n                **inputs,\n                max_new_tokens=max_new_tokens,\n                temperature=1.0,\n                do_sample=False,\n                pad_token_id=tokenizer.eos_token_id,\n            )\n            completion = tokenizer.decode(\n                outputs[0][inputs['input_ids'].shape[1]:],\n                skip_special_tokens=True\n            )\n            pred = extract_answer(completion)\n            ok   = answers_match(pred, ex['answer'])\n            correct += ok\n            print(f\"  Q: {ex['problem'][:60]}...\" if len(ex['problem'])>60 else f\"  Q: {ex['problem']}\")\n            print(f\"  Pred: {pred!r}  Gold: {ex['answer']!r}  {'✓' if ok else '✗'}\")\n            print()\n    acc = correct / len(problems)\n    print(f'Quick eval accuracy: {correct}/{len(problems)} = {acc:.1%}')\n    return acc\n\nquick_eval(MODEL, TOKENIZER, EVAL_PROBLEMS)","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Package submission.zip","metadata":{}},{"cell_type":"code","source":"def create_submission_zip(adapter_dir: str, zip_path: str):\n    \"\"\"\n    Packages the LoRA adapter into submission.zip.\n    Required file: adapter_config.json\n    Includes: adapter_model.safetensors (or .bin), tokenizer files.\n    \"\"\"\n    adapter_dir = Path(adapter_dir)\n    zip_path    = Path(zip_path)\n\n    # Validation\n    assert (adapter_dir / 'adapter_config.json').exists(), \\\n        'adapter_config.json is required!'\n\n    adapter_files = (\n        list(adapter_dir.glob('adapter_model*')) +\n        list(adapter_dir.glob('adapter_config*'))\n    )\n    assert adapter_files, 'No adapter weights found!'\n\n    # Read and validate adapter_config\n    with open(adapter_dir / 'adapter_config.json') as f:\n        cfg = json.load(f)\n    rank = cfg.get('r', 0)\n    assert rank <= 32, f'LoRA rank {rank} exceeds limit of 32!'\n    print(f'Validated: rank={rank}, base={cfg.get(\"base_model_name_or_path\")}')\n\n    # Create zip (adapter files at root level)\n    include_patterns = [\n        'adapter_config.json',\n        'adapter_model.safetensors',\n        'adapter_model.bin',\n        'tokenizer.json',\n        'tokenizer_config.json',\n        'special_tokens_map.json',\n    ]\n    with zipfile.ZipFile(zip_path, 'w', compression=zipfile.ZIP_DEFLATED) as zf:\n        for fname in include_patterns:\n            fpath = adapter_dir / fname\n            if fpath.exists():\n                zf.write(fpath, arcname=fname)\n                print(f'  Added: {fname} ({fpath.stat().st_size/1e6:.1f} MB)')\n\n    size_mb = zip_path.stat().st_size / 1e6\n    print(f'\\nsubmission.zip created: {zip_path} ({size_mb:.1f} MB)')\n    return str(zip_path)\n\n\ncreate_submission_zip(CFG.output_dir, CFG.submission_zip)","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Iterative ReST (optional, run after initial GRPO)\n\nIf time allows, run 1-2 rounds of rejection-sampling fine-tuning on top of the GRPO adapter.\nThis is the ReST / STaR loop: generate → filter correct → SFT → repeat.","metadata":{}},{"cell_type":"code","source":"from trl import SFTConfig, SFTTrainer\n\ndef rest_round(\n    model,\n    tokenizer,\n    examples: List[Dict],\n    cfg: Config,\n    n_rollouts: int = 4,\n    max_problems: int = 500,\n):\n    \"\"\"\n    One round of Rejection Sampling Fine-Tuning (ReST):\n    1. Sample rollouts per problem\n    2. Keep only correct traces\n    3. SFT on them\n    \"\"\"\n    print(f'ReST round: generating {n_rollouts} rollouts for {max_problems} problems...')\n    correct_traces = []\n    model.eval()\n\n    sample = random.sample(examples, min(max_problems, len(examples)))\n\n    with torch.no_grad():\n        for ex in sample:\n            prompt = make_prompt(ex['problem'], tokenizer)\n            inputs = tokenizer(prompt, return_tensors='pt',\n                               max_length=cfg.max_prompt_len,\n                               truncation=True).to(model.device)\n\n            outputs = model.generate(\n                **inputs,\n                max_new_tokens=cfg.max_completion_len,\n                do_sample=True,\n                temperature=0.8,\n                top_p=0.95,\n                num_return_sequences=n_rollouts,\n                pad_token_id=tokenizer.eos_token_id,\n            )\n\n            for out in outputs:\n                completion = tokenizer.decode(\n                    out[inputs['input_ids'].shape[1]:],\n                    skip_special_tokens=True\n                )\n                if answers_match(extract_answer(completion), ex['answer']):\n                    correct_traces.append({\n                        'text': prompt + completion + tokenizer.eos_token\n                    })\n\n    print(f'Collected {len(correct_traces)} correct traces.')\n    if not correct_traces:\n        print('No correct traces — skipping SFT.')\n        return model\n\n    rest_ds = Dataset.from_list(correct_traces)\n\n    sft_cfg = SFTConfig(\n        output_dir=cfg.output_dir + '_rest',\n        num_train_epochs=1,\n        per_device_train_batch_size=1,\n        gradient_accumulation_steps=4,\n        learning_rate=2e-6,\n        max_seq_length=cfg.max_prompt_len + cfg.max_completion_len,\n        bf16=True,\n        logging_steps=5,\n        report_to='none',\n        dataset_text_field='text',\n    )\n    sft_trainer = SFTTrainer(\n        model=model,\n        args=sft_cfg,\n        train_dataset=rest_ds,\n        tokenizer=tokenizer,\n    )\n    model.train()\n    sft_trainer.train()\n    print('ReST SFT complete.')\n    return model\n\n\n# Uncomment to run after GRPO:\n MODEL = rest_round(MODEL, TOKENIZER, EXAMPLES, CFG, n_rollouts=4, max_problems=300)\n MODEL.save_pretrained(CFG.output_dir)\ncreate_submission_zip(CFG.output_dir, CFG.submission_zip)\n\nprint('ReST cell ready (uncomment lines above to run).')","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# PHASE 2:","metadata":{}},{"cell_type":"code","source":"# Ablation: disable PRM reward to measure its impact\nCFG.reward_prm_weight = 0.0\nprint(\"PRM disabled — running correctness + format only\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Promote to harder buckets sooner (good if base model is already strong)\nCURRICULUM.threshold = 0.60\nprint(f\"Promotion threshold lowered to {CURRICULUM.threshold}\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Pull competition math datasets — all use \\boxed{} natively\nfrom datasets import load_dataset\n\ndef load_competition_math():\n    extra = []\n\n    # AMC/AIME via MATH-lighteval\n    try:\n        ds = load_dataset(\"lighteval/MATH\", \"all\", split=\"test\", trust_remote_code=True)\n        for ex in ds:\n            ans = extract_boxed(ex.get(\"solution\", \"\"))\n            if ex.get(\"problem\") and ans:\n                extra.append({\n                    \"problem\":    ex[\"problem\"],\n                    \"solution\":   ex[\"solution\"],\n                    \"answer\":     ans,\n                    \"source\":     \"math_test\",\n                    \"sol_len\":    len(ex[\"solution\"]),\n                    \"difficulty\": {\"Level 1\":0,\"Level 2\":1,\"Level 3\":2,\n                                   \"Level 4\":3,\"Level 5\":4}.get(ex.get(\"level\",\"\"), 3),\n                })\n    except Exception as e:\n        print(f\"MATH test load failed: {e}\")\n\n    # Omni-MATH (olympiad-level)\n    try:\n        ds2 = load_dataset(\"KbsdJames/Omni-MATH\", split=\"test\")\n        for ex in ds2:\n            ans = ex.get(\"answer\", \"\")\n            if ex.get(\"problem\") and ans:\n                extra.append({\n                    \"problem\":    ex[\"problem\"],\n                    \"solution\":   ex.get(\"solution\", \"\"),\n                    \"answer\":     ans,\n                    \"source\":     \"omni_math\",\n                    \"sol_len\":    len(ex.get(\"solution\", \"\")),\n                    \"difficulty\": 4,  # olympiad = hardest bucket\n                })\n    except Exception as e:\n        print(f\"Omni-MATH load failed: {e}\")\n\n    print(f\"Loaded {len(extra)} competition examples\")\n    return extra\n\nCOMPETITION_EXAMPLES = load_competition_math()\n\n# Merge with main dataset and re-bucket\nALL_EXAMPLES = EXAMPLES + COMPETITION_EXAMPLES\nrandom.shuffle(ALL_EXAMPLES)\nprint(f\"Total after merge: {len(ALL_EXAMPLES)}\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import hashlib\n\ndef deduplicate(examples):\n    seen = set()\n    clean = []\n    for ex in examples:\n        # Hash on first 200 chars of problem text\n        key = hashlib.md5(ex[\"problem\"][:200].encode()).hexdigest()\n        if key not in seen:\n            seen.add(key)\n            clean.append(ex)\n    print(f\"Deduplication: {len(examples)} → {len(clean)} examples\")\n    return clean\n\nALL_EXAMPLES = deduplicate(ALL_EXAMPLES)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def filter_by_token_length(examples, tokenizer, max_tokens=300):\n    filtered = []\n    for ex in examples:\n        toks = tokenizer(ex[\"problem\"], return_tensors=\"pt\")\n        if toks[\"input_ids\"].shape[1] <= max_tokens:\n            filtered.append(ex)\n    print(f\"Length filter ({max_tokens} tok): {len(examples)} → {len(filtered)}\")\n    return filtered\n\nEXAMPLES_FILTERED = filter_by_token_length(ALL_EXAMPLES, TOKENIZER, max_tokens=300)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Paste this into a cell and run during or after training to parse the log\nimport re\n\ndef parse_grpo_logs(log_path=\"/kaggle/working/trainer_log.jsonl\"):\n    import json\n    rewards, kls, entropies, steps = [], [], [], []\n    try:\n        with open(log_path) as f:\n            for line in f:\n                entry = json.loads(line)\n                if \"reward/mean\" in entry:\n                    rewards.append(entry[\"reward/mean\"])\n                    kls.append(entry.get(\"kl\", 0))\n                    entropies.append(entry.get(\"policy/entropy\", 0))\n                    steps.append(entry.get(\"step\", len(steps)))\n    except FileNotFoundError:\n        print(\"Log file not found — check output_dir\")\n        return\n\n    print(f\"Steps logged: {len(steps)}\")\n    if rewards:\n        print(f\"Reward  — start: {rewards[0]:.3f}  end: {rewards[-1]:.3f}  \"\n              f\"peak: {max(rewards):.3f}\")\n    if kls:\n        print(f\"KL div  — mean: {sum(kls)/len(kls):.3f}  max: {max(kls):.3f}  \"\n              f\"{'⚠ HIGH' if max(kls) > 0.5 else '✓ OK'}\")\n    if entropies:\n        print(f\"Entropy — mean: {sum(entropies)/len(entropies):.3f}  \"\n              f\"min: {min(entropies):.3f}  \"\n              f\"{'⚠ COLLAPSING' if min(entropies) < 0.1 else '✓ OK'}\")\n\nparse_grpo_logs()","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Quick VRAM check to auto-set num_generations\nimport torch\n\ndef suggest_num_generations():\n    if not torch.cuda.is_available():\n        return 4\n    vram_gb = torch.cuda.get_device_properties(0).total_memory / 1e9\n    print(f\"GPU: {torch.cuda.get_device_name(0)}  VRAM: {vram_gb:.1f} GB\")\n    if vram_gb >= 40:\n        n = 16\n    elif vram_gb >= 24:\n        n = 8\n    elif vram_gb >= 16:\n        n = 4\n    else:\n        n = 2\n    print(f\"Recommended num_generations: {n}\")\n    return n\n\nCFG.num_generations = suggest_num_generations()","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Run this after rest_round() to update the zip with the improved adapter\nMODEL.save_pretrained(CFG.output_dir)\nTOKENIZER.save_pretrained(CFG.output_dir)\n\n# Re-patch base model name\nimport json\ncfg_path = Path(CFG.output_dir) / \"adapter_config.json\"\nwith open(cfg_path) as f:\n    adapter_cfg = json.load(f)\nadapter_cfg[\"base_model_name_or_path\"] = \"nvidia/Nemotron-3-Nano-30B\"\nwith open(cfg_path, \"w\") as f:\n    json.dump(adapter_cfg, f, indent=2)\n\ncreate_submission_zip(CFG.output_dir, CFG.submission_zip)\nprint(\"Submission updated after ReST.\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Sweep over key hyperparams and track quick-eval accuracy\n# Run this if you have time budget for ~3-4 training runs\n\nSWEEP = [\n    {\"lr\": 5e-6, \"prm_weight\": 0.30, \"threshold\": 0.70, \"label\": \"baseline\"},\n    {\"lr\": 2e-6, \"prm_weight\": 0.50, \"threshold\": 0.60, \"label\": \"high_prm_fast_curr\"},\n    {\"lr\": 1e-5, \"prm_weight\": 0.00, \"threshold\": 0.70, \"label\": \"no_prm_high_lr\"},\n]\n\nresults = []\nfor run in SWEEP:\n    print(f\"\\n{'='*50}\")\n    print(f\"Run: {run['label']}\")\n    CFG.learning_rate      = run[\"lr\"]\n    CFG.reward_prm_weight  = run[\"prm_weight\"]\n    CURRICULUM.threshold   = run[\"threshold\"]\n\n    # (Re-initialise trainer with new CFG and train — abbreviated here)\n    # trainer = GRPOTrainer(...)\n    # trainer.train()\n    # acc = quick_eval(MODEL, TOKENIZER, EVAL_PROBLEMS)\n\n    acc = None  # replace with actual acc from quick_eval()\n    results.append({\"label\": run[\"label\"], \"accuracy\": acc})\n    print(f\"Accuracy: {acc}\")\n\nprint(\"\\nSweep results:\")\nfor r in sorted(results, key=lambda x: x[\"accuracy\"] or 0, reverse=True):\n    print(f\"  {r['label']}: {r['accuracy']}\")","metadata":{"trusted":
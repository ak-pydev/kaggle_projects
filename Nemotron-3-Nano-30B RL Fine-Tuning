{"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.12.12","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceType":"competition","sourceId":129716,"databundleVersionId":16082784}],"dockerImageVersionId":31329,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":true}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"markdown","source":"# Nemotron-3-Nano-30B — RL Fine-Tuning (Unsloth backend)\n## Strategy: Curriculum RL + PRM Reward + Format-Aware Reward Shaping via GRPO\n\n**Kaggle setup**: GPU T4 x2 or P100 · Internet ON · Python 3.10 kernel\n\n### Why Unsloth?\nEvery numpy ABI error I've hit (`dtype size changed`, `ufuncs must have type numpy.ufunc`)\ncomes from Kaggle's Docker image having numpy 2.x baked in at the C-extension level — no amount\nof `pip uninstall` fixes it in-process. Unsloth ships its own pre-compiled, ABI-consistent stack\nand wraps `GRPOTrainer` cleanly. It also runs ~2x faster on T4/P100 via custom CUDA kernels.","metadata":{}},{"cell_type":"markdown","source":"## Install (Unsloth + deps)","metadata":{}},{"cell_type":"code","source":"import subprocess, sys\n\ndef sh(cmd, check=True):\n    proc = subprocess.run(\n        cmd, shell=True, text=True,\n        stdout=subprocess.PIPE, stderr=subprocess.STDOUT)\n    out = proc.stdout\n    print(out[-2000:] if len(out) > 2000 else out)\n    if check and proc.returncode != 0:\n        raise RuntimeError(f\"Command failed: {cmd}\")\n\n# Use Kaggle's pre-installed torch — do NOT reinstall it.\n# Kaggle's torch is compiled for the exact CUDA/GPU in this environment.\n# Replacing it with another wheel causes: CUDA error: no kernel image available\nprint(\"1/3  checking pre-installed torch + GPU...\")\nimport torch\n\nif not torch.cuda.is_available():\n    raise RuntimeError(\n        \"\\n*** NO GPU DETECTED ***\\n\"\n        \"Kaggle: right panel → Settings → Accelerator → GPU T4 x2 or P100\\n\"\n        \"Then restart the session.\\n\"\n    )\n\ncc = torch.cuda.get_device_capability()\nprint(f\"  torch  : {torch.__version__}\")\nprint(f\"  CUDA   : {torch.version.cuda}\")\nprint(f\"  GPU    : {torch.cuda.get_device_name(0)}\")\nprint(f\"  CC     : {cc[0]}.{cc[1]}\")\n\nprint(\"\\n2/4  installing core training deps...\")\nsh(f\"{sys.executable} -m pip install --no-cache-dir \"\n   f\"'trl==0.14.0' 'peft==0.13.2' 'accelerate==0.34.2' \"\n   f\"'transformers>=4.45.0' 'protobuf==3.20.3'\")\n\nprint(\"\\n3/4  installing Nemotron architecture deps (compiles CUDA — takes 10-20 min)...\")\nsh(f\"{sys.executable} -m pip install --no-cache-dir \"\n   f\"'mamba-ssm' 'causal-conv1d>=1.4.0' \"\n   f\"--no-build-isolation\")\n\nprint(\"\\n4/4  installing bitsandbytes + data deps...\")\nsh(f\"{sys.executable} -m pip install --no-cache-dir 'bitsandbytes>=0.43.0'\")\nsh(f\"{sys.executable} -m pip install --no-cache-dir \"\n   f\"'datasets==2.21.0' 'sentencepiece' 'math_verify' 'vllm'\")\n\nprint(\"\\n=== Verifying imports ===\")\nimport numpy as np\nimport bitsandbytes as bnb\nfrom transformers import AutoTokenizer, AutoModelForCausalLM, BitsAndBytesConfig\nfrom peft import LoraConfig, get_peft_model, TaskType\nfrom trl import GRPOConfig, GRPOTrainer, SFTConfig, SFTTrainer\nimport mamba_ssm\n\nprint(f\"  mamba-ssm    : {mamba_ssm.__version__}\")\nprint(f\"  numpy        : {np.__version__}\")\nprint(f\"  torch        : {torch.__version__}\")\nprint(f\"  bitsandbytes : {bnb.__version__}\")\nprint(f\"  trl          : {__import__('trl').__version__}\")\nprint(f\"  GRPOTrainer  : OK\")\nprint(\"\\n>>> All imports clean — continue to Cell 2 <<<\")\n","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Load HF token from Kaggle secrets\nfrom kaggle_secrets import UserSecretsClient\nimport os\n\ntry:\n    secrets = UserSecretsClient()\n    user_secrets = UserSecretsClient()\n    hf_token = user_secrets.get_secret(\"HF_TOKEN\")\n    os.environ[\"HF_TOKEN\"] = hf_token\n    os.environ[\"HUGGING_FACE_HUB_TOKEN\"] = hf_token\n    print(\"HF token loaded from Kaggle secrets ✓\")\nexcept Exception as e:\n    print(f\"WARNING: could not load HF token: {e}\")\n    print(\"Trying without token — will fail for gated models\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-08T06:27:53.297716Z","iopub.execute_input":"2026-04-08T06:27:53.298500Z","iopub.status.idle":"2026-04-08T06:27:53.372693Z","shell.execute_reply.started":"2026-04-08T06:27:53.298464Z","shell.execute_reply":"2026-04-08T06:27:53.372037Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"##  Imports & config","metadata":{}},{"cell_type":"code","source":"import os, re, json, math, random, zipfile, hashlib, warnings\nfrom pathlib import Path\nfrom dataclasses import dataclass, field\nfrom typing import List, Dict, Optional\nfrom collections import defaultdict\n\nimport numpy as np\nimport torch\nfrom datasets import load_dataset, Dataset\nfrom transformers import (\n    AutoTokenizer,\n    AutoModelForCausalLM,\n    BitsAndBytesConfig,\n    GenerationConfig,\n    TrainerCallback,\n)\nfrom peft import LoraConfig, get_peft_model, TaskType\nfrom trl import GRPOConfig, GRPOTrainer, SFTConfig, SFTTrainer\n\ndef is_bfloat16_supported():\n    return torch.cuda.is_bf16_supported()\n\nwarnings.filterwarnings('ignore')\ntorch.manual_seed(42); random.seed(42); np.random.seed(42)\n\n\n@dataclass\nclass Config:\n    # ── Model ─────────────────────────────────────────────────────────────────\n    # Set model_local to your /kaggle/input/... path if added via Kaggle Models.\n    # Leave as \"\" to fall back to HF hub (requires Internet ON).\n    model_local: str  = '/kaggle/input/NVIDIA-Nemotron-3-Nano-30B-A3B-BF16'\n    model_id: str     = 'nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-BF16' \n\n    # ── LoRA ──────────────────────────────────────────────────────────────────\n    lora_rank: int            = 32\n    lora_alpha: int           = 64\n    lora_dropout: float       = 0.0\n    target_modules: List[str] = field(default_factory=lambda: [\n        'q_proj', 'k_proj', 'v_proj', 'o_proj',\n        'gate_proj', 'up_proj', 'down_proj'\n    ])\n    max_seq_length: int       = 2048\n\n    # ── Data ──────────────────────────────────────────────────────────────────\n    max_samples: int            = 8000\n    max_prompt_len: int         = 512\n    max_completion_len: int     = 1024\n    num_difficulty_buckets: int = 5\n    promote_threshold: float    = 0.70\n\n    # ── GRPO ──────────────────────────────────────────────────────────────────\n    num_generations: int             = 8\n    learning_rate: float             = 5e-6\n    per_device_train_batch_size: int = 1\n    gradient_accumulation_steps: int = 8\n    num_train_epochs: int            = 2\n    max_grad_norm: float             = 0.5\n    warmup_ratio: float              = 0.05\n    save_steps: int                  = 50\n\n    # ── Rewards ───────────────────────────────────────────────────────────────\n    reward_correct: float    = 1.0\n    reward_format_box: float = 0.15\n    reward_format_int: float = 0.10\n    reward_repetition: float = -0.20\n    reward_prm_weight: float = 0.30\n\n    # ── Output ────────────────────────────────────────────────────────────────\n    output_dir: str     = '/kaggle/working/nemotron_lora_v1'\n    submission_zip: str = '/kaggle/working/submission_v1.zip'\n\n\nCFG = Config()\n\n# Auto-set num_generations based on VRAM\nif torch.cuda.is_available():\n    vram_gb = torch.cuda.get_device_properties(0).total_memory / 1e9\n    print(f\"GPU: {torch.cuda.get_device_name(0)}  VRAM: {vram_gb:.1f} GB\")\n    if vram_gb < 16:   CFG.num_generations = 2\n    elif vram_gb < 24: CFG.num_generations = 4\n    print(f\"num_generations: {CFG.num_generations}\")\n\nprint(json.dumps(CFG.__dict__, indent=2, default=str))","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## System prompt + answer extraction","metadata":{}},{"cell_type":"code","source":"SYSTEM_PROMPT = \"\"\"\\\nYou are an expert mathematical reasoning assistant.\nSolve each problem step by step using clear logical reasoning.\nAlways place your final answer inside \\boxed{} at the end of your response.\n\nRules:\n- Show all intermediate steps clearly\n- Do not repeat yourself\n- Simplify your final answer as much as possible\n- Put ONLY the final answer inside \\boxed{}, nothing else\n\"\"\"\n\ndef make_prompt(problem: str, tokenizer) -> str:\n    messages = [\n        {'role': 'system', 'content': SYSTEM_PROMPT},\n        {'role': 'user',   'content': problem.strip()},\n    ]\n    return tokenizer.apply_chat_template(\n        messages, tokenize=False, add_generation_prompt=True)\n\n\ndef extract_boxed(text: str) -> Optional[str]:\n    idx = text.rfind(r'\\boxed{')\n    if idx == -1: return None\n    start = idx + len(r'\\boxed{')\n    depth, end = 1, start\n    while end < len(text) and depth > 0:\n        if   text[end] == '{': depth += 1\n        elif text[end] == '}': depth -= 1\n        end += 1\n    return text[start:end-1].strip() if depth == 0 else None\n\ndef extract_last_number(text: str) -> Optional[str]:\n    nums = re.findall(r'-?\\d+\\.?\\d*', text)\n    return nums[-1] if nums else None\n\ndef extract_answer(text: str) -> Optional[str]:\n    ans = extract_boxed(text)\n    if ans: return ans\n    for pat in [r'(?:answer is|therefore)[:\\s]+([^\\n.]+)', r'=\\s*([^\\n=]+)$']:\n        m = re.search(pat, text, re.IGNORECASE)\n        if m: return m.group(1).strip()\n    return extract_last_number(text)\n\ndef answers_match(pred: Optional[str], gold: str, tol: float = 1e-6) -> bool:\n    if pred is None: return False\n    pred, gold = pred.strip(), gold.strip()\n    if pred == gold: return True\n    try:\n        return abs(float(pred) - float(gold)) / max(abs(float(gold)), 1e-9) < tol\n    except (ValueError, ZeroDivisionError):\n        return False\n\nassert extract_boxed(r'The answer is \\boxed{42}') == '42'\nassert answers_match('42', '42.0000001')\nprint('Answer extraction OK.')\n","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"##  Data loading + difficulty bucketing","metadata":{}},{"cell_type":"code","source":"def load_and_bucket_data(cfg: Config) -> List[Dict]:\n    all_examples = []\n\n    print('Loading NuminaMath-CoT...')\n    try:\n        for ex in load_dataset('AI-MO/NuminaMath-CoT', split='train'):\n            prob = ex.get('problem') or ex.get('question', '')\n            sol  = ex.get('solution') or ex.get('answer', '')\n            ans  = extract_boxed(sol) or extract_last_number(sol)\n            if prob and ans:\n                all_examples.append({'problem':prob, 'solution':sol,\n                                      'answer':ans, 'source':'numina',\n                                      'sol_len':len(sol), 'level':''})\n    except Exception as e:\n        print(f'  NuminaMath failed: {e}')\n\n    print('Loading MATH dataset...')\n    try:\n        for ex in load_dataset('lighteval/MATH', 'all', split='train',\n                               trust_remote_code=True):\n            prob = ex.get('problem', '')\n            sol  = ex.get('solution', '')\n            ans  = extract_boxed(sol)\n            if prob and ans:\n                all_examples.append({'problem':prob, 'solution':sol,\n                                      'answer':ans, 'source':'math',\n                                      'sol_len':len(sol),\n                                      'level':ex.get('level', '')})\n    except Exception as e:\n        print(f'  MATH failed: {e}')\n\n    print(f'Raw: {len(all_examples)} examples')\n    random.shuffle(all_examples)\n    all_examples = all_examples[:cfg.max_samples]\n\n    sol_lens    = [ex['sol_len'] for ex in all_examples]\n    percentiles = np.percentile(sol_lens, [20, 40, 60, 80])\n    level_map   = {'Level 1':0,'Level 2':1,'Level 3':2,'Level 4':3,'Level 5':4}\n\n    for ex in all_examples:\n        if ex['level'] in level_map:\n            ex['difficulty'] = level_map[ex['level']]\n        else:\n            ex['difficulty'] = next(\n                (i for i,p in enumerate(percentiles) if ex['sol_len']<=p), 4)\n\n    dist = defaultdict(int)\n    for ex in all_examples: dist[ex['difficulty']] += 1\n    print('Difficulty:', dict(sorted(dist.items())))\n    return all_examples\n\n\ndef load_competition_math() -> List[Dict]:\n    extra = []\n    try:\n        for ex in load_dataset('lighteval/MATH', 'all', split='test',\n                               trust_remote_code=True):\n            ans = extract_boxed(ex.get('solution', ''))\n            if ex.get('problem') and ans:\n                extra.append({'problem':ex['problem'], 'solution':ex['solution'],\n                               'answer':ans, 'source':'math_test',\n                               'sol_len':len(ex['solution']),\n                               'level':ex.get('level', '')})\n    except Exception as e:\n        print(f'  MATH test failed: {e}')\n    try:\n        for ex in load_dataset('KbsdJames/Omni-MATH', split='test'):\n            ans = ex.get('answer', '')\n            if ex.get('problem') and ans:\n                extra.append({'problem':ex['problem'],\n                               'solution':ex.get('solution', ''),\n                               'answer':ans, 'source':'omni_math',\n                               'sol_len':len(ex.get('solution', '')),\n                               'level':'Level 5'})\n    except Exception as e:\n        print(f'  Omni-MATH failed: {e}')\n    print(f'Competition: {len(extra)} examples')\n    return extra\n\n\ndef deduplicate(examples: List[Dict]) -> List[Dict]:\n    seen, clean = set(), []\n    for ex in examples:\n        key = hashlib.md5(ex['problem'][:200].encode()).hexdigest()\n        if key not in seen:\n            seen.add(key); clean.append(ex)\n    print(f'Dedup: {len(examples)} → {len(clean)}')\n    return clean\n\n\ndef filter_by_token_length(examples: List[Dict], tokenizer,\n                            max_tokens: int = 300) -> List[Dict]:\n    out = [ex for ex in examples\n           if tokenizer(ex['problem'], return_tensors='pt')[\n               'input_ids'].shape[1] <= max_tokens]\n    print(f'Length filter: {len(examples)} → {len(out)}')\n    return out\n\n\nEXAMPLES = load_and_bucket_data(CFG)\nprint(f'Phase 1 dataset: {len(EXAMPLES)} examples')\n","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Curriculum scheduler","metadata":{}},{"cell_type":"code","source":"class CurriculumScheduler:\n    \"\"\"Gates harder buckets; promotes when solve-rate >= threshold.\"\"\"\n\n    def __init__(self, examples: List[Dict], cfg: Config):\n        self.threshold  = cfg.promote_threshold\n        self.max_bucket = cfg.num_difficulty_buckets - 1\n        self.buckets: Dict[int, List[Dict]] = defaultdict(list)\n        for ex in examples:\n            self.buckets[ex['difficulty']].append(ex)\n        self.active_max   = 0\n        self.solve_counts = defaultdict(lambda: [0, 0])\n\n    def record(self, bucket: int, correct: bool):\n        self.solve_counts[bucket][1] += 1\n        if correct: self.solve_counts[bucket][0] += 1\n        c, t = self.solve_counts[self.active_max]\n        if t >= 20 and self.active_max < self.max_bucket and c/t >= self.threshold:\n            self.active_max += 1\n            print(f'  [Curriculum] promoted → bucket {self.active_max} '                  f'(rate {c/t:.1%})')\n            self.solve_counts[self.active_max - 1] = [0, 0]\n\n    def status(self) -> str:\n        rows = []\n        for b in range(self.active_max + 1):\n            c, t = self.solve_counts[b]\n            rows.append(f'  Bucket {b}: {c}/{t} = {c/t:.1%}' if t\n                        else f'  Bucket {b}: no data yet')\n        return '\\n'.join(rows)\n\n\nCURRICULUM = CurriculumScheduler(EXAMPLES, CFG)\nprint(f'Curriculum ready. Bucket 0 size: {len(CURRICULUM.buckets[0])}')\n","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Reward functions","metadata":{}},{"cell_type":"code","source":"def prm_step_score(completion: str) -> float:\n    steps = [s.strip() for s in re.split(r'\\n+|(?<=[.!?])\\s+', completion)\n             if s.strip()]\n    if not steps: return 0.0\n    score, seen = 0.0, set()\n    for step in steps:\n        s = 0.5\n        if re.search(r'[=+\\-*/^]|\\\\frac|\\\\sqrt', step):              s += 0.20\n        if re.search(r'\\b(therefore|thus|so|hence|because|since|'\n                     r'we get|gives us)\\b', step, re.I):              s += 0.15\n        if len(step.split()) < 4:                                      s -= 0.20\n        key = ' '.join(step.lower().split()[:8])\n        if key in seen:                                                s -= 0.40\n        seen.add(key)\n        score += max(0.0, min(1.0, s))\n    return score / len(steps)\n\n\ndef format_reward(completion: str, gold: str) -> float:\n    r = 0.0\n    if r'\\boxed{' in completion: r += CFG.reward_format_box\n    boxed = extract_boxed(completion)\n    if boxed:\n        try:\n            g = float(gold)\n            if g == int(g):\n                try:\n                    if float(boxed) == int(float(boxed)): r += CFG.reward_format_int\n                except ValueError: pass\n        except ValueError: pass\n    words = completion.lower().split()\n    if len(words) > 20:\n        bigrams = [f'{words[i]} {words[i+1]}' for i in range(len(words)-1)]\n        if len(set(bigrams)) / len(bigrams) < 0.6: r += CFG.reward_repetition\n    return r\n\n\ndef compute_reward(completions: List[str], gold_answers: List[str],\n                   difficulty_buckets: List[int]) -> List[float]:\n    rewards = []\n    for completion, gold, bucket in zip(completions, gold_answers, difficulty_buckets):\n        pred = extract_answer(completion)\n        is_correct = answers_match(pred, gold)\n        r  = CFG.reward_correct if is_correct else 0.0\n        r += CFG.reward_prm_weight * prm_step_score(completion)\n        r += format_reward(completion, gold)\n        rewards.append(r)\n        CURRICULUM.record(bucket, is_correct)\n    return rewards\n\n\ndef _unpack_completion(c) -> str:\n    \"\"\"\n    trl 0.14 delivers completions in several formats. Handles all cases:\n      - plain string               \"answer text\"           <- most common\n      - list of chat dicts         [{\"role\":\"assistant\",\"content\":\"...\"}]\n      - single chat dict           {\"role\":\"assistant\",\"content\":\"...\"}\n      - list of strings            [\"answer text\"]\n    Previous bug: when c=[str], c[0] was a string, then c[0]['content']\n    tried to index a string with 'content' ->\n      TypeError: list indices must be integers or slices, not str\n    \"\"\"\n    if isinstance(c, str):\n        return c\n    if isinstance(c, dict):\n        return c.get('content', str(c))\n    if isinstance(c, list) and c:\n        first = c[0]\n        if isinstance(first, dict):\n            return first.get('content', str(first))\n        if isinstance(first, str):\n            return first\n        return str(first)\n    return str(c)\n\n\ndef grpo_reward_fn(prompts, completions, answer=None, difficulty=None, **kwargs):\n    completions = [_unpack_completion(c) for c in completions]\n    if answer    is None: answer     = [''] * len(completions)\n    if difficulty is None: difficulty = [0]  * len(completions)\n    difficulty = [int(d) if not isinstance(d, int) else d for d in difficulty]\n    return compute_reward(completions, answer, difficulty)\n\n\n# Smoke tests\nok  = compute_reward([r'We get 3+4=7. Therefore \\boxed{7}.'], ['7'], [0])\nbad = compute_reward([r'\\boxed{5}.'], ['7'], [0])\nprint(f'Reward  correct={ok[0]:.3f}  wrong={bad[0]:.3f}')\n\n# _unpack_completion edge cases — covers the exact TypeError that was thrown\nassert _unpack_completion(\"hello\") == \"hello\"\nassert _unpack_completion({\"role\": \"assistant\", \"content\": \"hi\"}) == \"hi\"\nassert _unpack_completion([{\"role\": \"assistant\", \"content\": \"hi\"}]) == \"hi\"\nassert _unpack_completion([\"hi\"]) == \"hi\"  # <- this was the failing case\nprint(\"_unpack_completion: all edge cases OK\")\n","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Load model + LoRA via Unsloth","metadata":{}},{"cell_type":"code","source":"from transformers import AutoTokenizer, AutoModelForCausalLM, BitsAndBytesConfig\nfrom peft import LoraConfig, get_peft_model, TaskType\n\ndef load_model_and_tokenizer(cfg: Config):\n    model_path = (cfg.model_local\n                  if cfg.model_local and Path(cfg.model_local).exists()\n                  else cfg.model_id)\n    cc = torch.cuda.get_device_capability()\n    print(f\"Loading: {model_path}\")\n    print(f\"GPU: {torch.cuda.get_device_name(0)}  CC: {cc[0]}.{cc[1]}\")\n\n    tokenizer = AutoTokenizer.from_pretrained(\n        model_path,\n        use_fast=True,\n        padding_side='left',\n        trust_remote_code=True,\n        token=os.environ.get(\"HF_TOKEN\")\n    )\n    if tokenizer.pad_token is None:\n        tokenizer.pad_token = tokenizer.eos_token\n\n    # BitsAndBytes 4-bit quant — works on any CUDA GPU regardless of CC\n    bnb_cfg = BitsAndBytesConfig(\n        load_in_4bit=True,\n        bnb_4bit_quant_type='nf4',\n        bnb_4bit_use_double_quant=True,\n        bnb_4bit_compute_dtype=(\n            torch.bfloat16 if torch.cuda.is_bf16_supported() else torch.float16\n        ),\n    )\n    model = AutoModelForCausalLM.from_pretrained(\n        model_path,\n        quantization_config=bnb_cfg,\n        device_map='auto',\n        trust_remote_code=True,\n        ignore_mismatched_sizes=True,\n        token=os.environ.get(\"HF_TOKEN\")\n    )\n    \n    model.config.use_cache = False\n    model.enable_input_require_grads()\n\n    # Standard PEFT LoRA — no Unsloth dependency\n    lora_cfg = LoraConfig(\n        r=cfg.lora_rank,\n        lora_alpha=cfg.lora_alpha,\n        target_modules=cfg.target_modules,\n        lora_dropout=cfg.lora_dropout,\n        bias='none',\n        task_type=TaskType.CAUSAL_LM,\n    )\n    model = get_peft_model(model, lora_cfg)\n    model.print_trainable_parameters()\n    return model, tokenizer\n\n\nMODEL, TOKENIZER = load_model_and_tokenizer(CFG)\nprint('Model + LoRA ready.')\n","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Build HF dataset","metadata":{}},{"cell_type":"code","source":"def build_hf_dataset(examples: List[Dict], tokenizer, cfg: Config) -> Dataset:\n    rows = []\n    for ex in examples:\n        prompt = make_prompt(ex['problem'], tokenizer)\n        if tokenizer(prompt, return_tensors='pt')[\n                'input_ids'].shape[1] > cfg.max_prompt_len:\n            continue\n        rows.append({'prompt':     prompt,\n                     'answer':     ex['answer'],\n                     'difficulty': ex['difficulty']})\n    ds = Dataset.from_list(rows)\n    print(f'Dataset: {len(ds)} rows')\n    return ds\n\n\nTRAIN_DS = build_hf_dataset(EXAMPLES, TOKENIZER, CFG)\n","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Curriculum callback","metadata":{}},{"cell_type":"code","source":"class CurriculumCallback(TrainerCallback):\n    def on_log(self, args, state, control, logs=None, **kwargs):\n        if state.global_step % 50 == 0 and state.global_step > 0:\n            print(f'\\n[Step {state.global_step}] Curriculum:')\n            print(CURRICULUM.status())\n\nprint('Callback ready.')\n","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## GRPO training (Phase 1)","metadata":{}},{"cell_type":"code","source":"from transformers import GenerationConfig\n\n# Set generation config on the MODEL before constructing trainer.\n# trainer.model may be a different wrapper object — setting it after is unreliable.\nMODEL.generation_config = GenerationConfig(\n    do_sample=True,\n    temperature=0.9,\n    top_p=0.95,\n)\n\ndef make_grpo_args(cfg: Config) -> GRPOConfig:\n    \"\"\"\n    Always build a fresh GRPOConfig from current cfg values.\n    Never mutate grpo_args fields directly — TrainingArguments fields\n    are partially frozen after __post_init__ and silent mutation causes bugs.\n    \"\"\"\n    return GRPOConfig(\n        num_generations=cfg.num_generations,\n        max_prompt_length=cfg.max_prompt_len,\n        max_completion_length=cfg.max_completion_len,\n\n        learning_rate=cfg.learning_rate,\n        per_device_train_batch_size=cfg.per_device_train_batch_size,\n        gradient_accumulation_steps=cfg.gradient_accumulation_steps,\n        num_train_epochs=cfg.num_train_epochs,\n        max_grad_norm=cfg.max_grad_norm,\n        warmup_ratio=cfg.warmup_ratio,\n        lr_scheduler_type='cosine',\n        # paged_adamw_8bit is valid in trl 0.14; plain 'adamw_8bit' is not.\n        optim='paged_adamw_8bit',\n\n        output_dir=cfg.output_dir,\n        save_steps=cfg.save_steps,\n        logging_steps=10,\n        report_to='none',\n        bf16=is_bfloat16_supported(),\n        fp16=not is_bfloat16_supported(),\n        gradient_checkpointing=True,\n        remove_unused_columns=False,\n        dataloader_num_workers=0,\n    )\n\ngrpo_args = make_grpo_args(CFG)\n\ntrainer = GRPOTrainer(\n    model=MODEL,\n    args=grpo_args,\n    reward_funcs=[grpo_reward_fn],\n    train_dataset=TRAIN_DS,\n    processing_class=TOKENIZER,       \n    callbacks=[CurriculumCallback()],\n)\n\nprint('Starting GRPO training...')\ntrainer.train()\nprint('Training complete.')\n","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"##  Save adapter","metadata":{}},{"cell_type":"code","source":"def save_adapter(model, tokenizer, cfg: Config):\n    out = Path(cfg.output_dir)\n    out.mkdir(parents=True, exist_ok=True)\n    model.save_pretrained(str(out))\n    tokenizer.save_pretrained(str(out))\n    cfg_path = out / 'adapter_config.json'\n    assert cfg_path.exists(), 'adapter_config.json missing!'\n    with open(cfg_path) as f: ac = json.load(f)\n    ac['base_model_name_or_path'] = 'nvidia/Nemotron-3-Nano-30B'\n    with open(cfg_path, 'w') as f: json.dump(ac, f, indent=2)\n    print('Saved:', [p.name for p in out.iterdir()])\n\n\nsave_adapter(MODEL, TOKENIZER, CFG)\n","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Quick local evaluation","metadata":{}},{"cell_type":"code","source":"EVAL_PROBLEMS = [\n    {'problem': 'What is 15% of 200?',                                'answer': '30'},\n    {'problem': 'Solve for x: 2x + 5 = 17',                          'answer': '6'},\n    {'problem': 'What is the sum of the first 10 positive integers?', 'answer': '55'},\n    {'problem': 'A rectangle has length 12 and width 7. Its area?',   'answer': '84'},\n    {'problem': r'Simplify: $\\frac{3}{4} + \\frac{1}{6}$',            'answer': r'\\frac{11}{12}'},\n]\n\ndef quick_eval(model, tokenizer, problems, max_new_tokens=512):\n    model.eval()\n    correct = 0\n    with torch.no_grad():\n        for ex in problems:\n            inputs = tokenizer(make_prompt(ex['problem'], tokenizer),\n                               return_tensors='pt').to(model.device)\n            out = model.generate(\n                **inputs, max_new_tokens=max_new_tokens,\n                do_sample=False, pad_token_id=tokenizer.eos_token_id)\n            completion = tokenizer.decode(\n                out[0][inputs['input_ids'].shape[1]:], skip_special_tokens=True)\n            pred = extract_answer(completion)\n            ok   = answers_match(pred, ex['answer'])\n            correct += ok\n            print(f\"  {'✓' if ok else '✗'}  pred={pred!r:25s}  gold={ex['answer']!r}\")\n    model.train()\n    acc = correct / len(problems)\n    print(f'\\nAccuracy: {correct}/{len(problems)} = {acc:.1%}')\n    return acc\n\nquick_eval(MODEL, TOKENIZER, EVAL_PROBLEMS)\n","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Package submission.zip","metadata":{}},{"cell_type":"code","source":"def create_submission_zip(adapter_dir: str, zip_path: str):\n    adapter_dir = Path(adapter_dir)\n    zip_path    = Path(zip_path)\n    cfg_file    = adapter_dir / 'adapter_config.json'\n    assert cfg_file.exists(), 'adapter_config.json missing!'\n    with open(cfg_file) as f: ac = json.load(f)\n    rank = ac.get('r', 0)\n    assert rank <= 32, f'LoRA rank {rank} > 32!'\n    print(f'rank={rank}  base={ac.get(\"base_model_name_or_path\")}')\n    include = ['adapter_config.json', 'adapter_model.safetensors',\n               'adapter_model.bin',  'tokenizer.json',\n               'tokenizer_config.json', 'special_tokens_map.json']\n    with zipfile.ZipFile(zip_path, 'w', zipfile.ZIP_DEFLATED) as zf:\n        for fname in include:\n            p = adapter_dir / fname\n            if p.exists():\n                zf.write(p, arcname=fname)\n                print(f'  + {fname}  ({p.stat().st_size/1e6:.1f} MB)')\n    print(f'submission.zip → {zip_path}  ({zip_path.stat().st_size/1e6:.1f} MB)')\n\n\ncreate_submission_zip(CFG.output_dir, CFG.submission_zip)\n","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Phase 2: enhanced re-run\n\nRun **only after** you have a Phase 1 score. Re-trains with competition data + tuned config.\nPhase 1 adapter is preserved (different `output_dir`).","metadata":{}},{"cell_type":"code","source":"# ── Phase 2 config ────────────────────────────────────────────────────────────\nCFG.reward_prm_weight = 0.50\nCFG.learning_rate     = 2e-6\nCFG.promote_threshold = 0.60\nCFG.output_dir        = '/kaggle/working/nemotron_lora_v2'\nCFG.submission_zip    = '/kaggle/working/submission_v2.zip'\n\n# ── Step 1: load + merge competition data BEFORE building dataset ─────────────\nCOMPETITION = load_competition_math()\nALL_V2      = deduplicate(EXAMPLES + COMPETITION)\nALL_V2      = filter_by_token_length(ALL_V2, TOKENIZER, max_tokens=300)\nprint(f'Phase 2 dataset: {len(ALL_V2)} examples')\n\n# ── Step 2: rebuild curriculum + dataset ──────────────────────────────────────\nCURRICULUM = CurriculumScheduler(ALL_V2, CFG)\nTRAIN_DS   = build_hf_dataset(ALL_V2, TOKENIZER, CFG)\n\n# ── Step 3: build fresh GRPOConfig — never mutate the old one ─────────────────\nMODEL.generation_config = GenerationConfig(do_sample=True, temperature=0.9, top_p=0.95)\ngrpo_args_v2 = make_grpo_args(CFG)   # picks up updated CFG.learning_rate / output_dir\n\ntrainer = GRPOTrainer(\n    model=MODEL,\n    args=grpo_args,\n    reward_funcs=[grpo_reward_fn],\n    train_dataset=TRAIN_DS,\n    processing_class=TOKENIZER,       \n    callbacks=[CurriculumCallback()],\n)\n\n# ── Step 4: save + eval + zip ─────────────────────────────────────────────────\nsave_adapter(MODEL, TOKENIZER, CFG)\nquick_eval(MODEL, TOKENIZER, EVAL_PROBLEMS)\ncreate_submission_zip(CFG.output_dir, CFG.submission_zip)\nprint('Phase 2 complete.')\n","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Optional: ReST round","metadata":{}},{"cell_type":"code","source":"def rest_round(model, tokenizer, examples, cfg, n_rollouts=4, max_problems=300):\n    print(f'ReST: {n_rollouts} rollouts x {max_problems} problems')\n    correct_traces = []\n    model.eval()\n    sample = random.sample(examples, min(max_problems, len(examples)))\n    with torch.no_grad():\n        for ex in sample:\n            prompt = make_prompt(ex['problem'], tokenizer)\n            inputs = tokenizer(prompt, return_tensors='pt',\n                               max_length=cfg.max_prompt_len,\n                               truncation=True).to(model.device)\n            outs = model.generate(\n                **inputs, max_new_tokens=cfg.max_completion_len,\n                do_sample=True, temperature=0.8, top_p=0.95,\n                num_return_sequences=n_rollouts,\n                pad_token_id=tokenizer.eos_token_id,\n            )\n            for out in outs:\n                comp = tokenizer.decode(\n                    out[inputs['input_ids'].shape[1]:], skip_special_tokens=True)\n                if answers_match(extract_answer(comp), ex['answer']):\n                    correct_traces.append(\n                        {'text': prompt + comp + tokenizer.eos_token})\n    print(f'Collected {len(correct_traces)} correct traces.')\n    if not correct_traces:\n        print('No correct traces — skipping SFT.'); return model\n    model.train()\n    SFTTrainer(\n        model=model,\n        args=SFTConfig(\n            output_dir=cfg.output_dir+'_rest',\n            num_train_epochs=1,\n            per_device_train_batch_size=1,\n            gradient_accumulation_steps=4,\n            learning_rate=2e-6,\n            max_seq_length=cfg.max_prompt_len + cfg.max_completion_len,\n            bf16=is_bfloat16_supported(),\n            fp16=not is_bfloat16_supported(),\n            logging_steps=5, report_to='none',\n            dataset_text_field='text',\n        ),\n        train_dataset=Dataset.from_list(correct_traces),\n        tokenizer=tokenizer,\n    ).train()\n    print('ReST complete.')\n    return model\n\n\n# Uncomment to run after Phase 1 or Phase 2:\n# MODEL = rest_round(MODEL, TOKENIZER, EXAMPLES, CFG)\n# save_adapter(MODEL, TOKENIZER, CFG)\n# create_submission_zip(CFG.output_dir, CFG.submission_zip)\nprint('ReST function defined — uncomment 3 lines above to run.')\n","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"##  Log monitor","metadata":{}},{"cell_type":"code","source":"def parse_grpo_logs(log_path='/kaggle/working/trainer_log.jsonl'):\n    rewards, kls, entropies = [], [], []\n    try:\n        with open(log_path) as f:\n            for line in f:\n                e = json.loads(line)\n                if 'reward/mean' in e:\n                    rewards.append(e['reward/mean'])\n                    kls.append(e.get('kl', 0))\n                    entropies.append(e.get('policy/entropy', 0))\n    except FileNotFoundError:\n        print('Log not found — run after training starts.'); return\n    if rewards:\n        print(f'Reward   start={rewards[0]:.3f}  end={rewards[-1]:.3f}  '              f'peak={max(rewards):.3f}')\n    if kls:\n        print(f'KL       mean={sum(kls)/len(kls):.3f}  max={max(kls):.3f}',\n              '⚠ HIGH' if max(kls)>0.5 else '✓ OK')\n    if entropies:\n        print(f'Entropy  mean={sum(entropies)/len(entropies):.3f}  '              f'min={min(entropies):.3f}',\n              '⚠ COLLAPSING' if min(entropies)<0.1 else '✓ OK')\n\nparse_grpo_logs()\n","metadata":{},"outputs":[],"execution_count":null}]}
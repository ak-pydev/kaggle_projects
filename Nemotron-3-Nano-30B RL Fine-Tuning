    "def build_grpo_dataset(examples: List[Dict], tokenizer, cfg: Config) -> Dataset:\n",
    "    rows = []\n",
    "    for ex in examples:\n",
    "        prompt = render_chat(make_messages(ex['problem']), tokenizer, add_generation_prompt=True)\n",
    "        prompt_len = len(tokenizer(prompt, truncation=False)['input_ids'])\n",
    "        if prompt_len > cfg.grpo_max_prompt_length:\n",
    "            continue\n",
    "        rows.append({\n",
    "            'prompt': prompt,\n",
    "            'ground_truth': ex['answer'],\n",
    "            'task': 'math',\n",
    "        })\n",
    "    if not rows:\n",
    "        raise RuntimeError('The GRPO dataset is empty after prompt filtering.')\n",
    "    print(f'I built {len(rows)} GRPO rows.')\n",
    "    return Dataset.from_list(rows)\n",
    "\n",
    "\n",
    "\n",
    "def grpo_length_penalty_reward(completions, **kwargs):\n",
    "    \"\"\"Penalize very short completions that skip reasoning steps.\"\"\"    rewards = []\n",
    "    for completion in completions:\n",
    "        n = len(completion.split())\n",
    "        if n < 30:\n",
    "            rewards.append(-0.5)\n",
    "        elif n < 60:\n",
    "            rewards.append(0.5)\n",
    "        else:\n",
    "            rewards.append(1.0)\n",
    "    return rewards\n",
    "\n",
    "\n",
    "def grpo_box_format_reward(completions, **kwargs):\n",
    "    return [1.0 if r'\\boxed{' in completion else 0.0 for completion in completions]\n",
    "\n",
    "\n",
    "\n",
    "def grpo_accuracy_reward(completions, ground_truth, **kwargs):\n",
    "    rewards = []\n",
    "    for completion, gold in zip(completions, ground_truth):\n",
    "        pred = extract_answer(completion)\n",
    "        rewards.append(1.0 if answers_match(pred, gold) else 0.0)\n",
    "    return rewards\n",
    "\n",
    "\n",
    "if CFG.grpo_enabled:\n",
    "    try:\n",
    "        from trl import GRPOConfig, GRPOTrainer\n",
    "    except ImportError:\n",
    "        print('I could not import GRPOTrainer from this TRL build, so I am skipping the GRPO scaffold.')\n",
    "    else:\n",
    "        print('I am enabling the experimental GRPO scaffold.')\n",
    "        print('I only recommend this for experimentation, not as a verified single-A100 Nemotron RL recipe.')\n",
    "        GRPO_DS = build_grpo_dataset(TRAIN_EXAMPLES, TOKENIZER, CFG)\n",
    "        grpo_args = GRPOConfig(\n",
    "            output_dir=str(Path(CFG.output_dir) / 'grpo_stage'),\n",
    "            learning_rate=CFG.grpo_learning_rate,\n",
    "            per_device_train_batch_size=1,\n",
    "            gradient_accumulation_steps=CFG.grpo_gradient_accumulation_steps,\n",
    "            num_train_epochs=CFG.grpo_num_train_epochs,\n",
    "            logging_steps=CFG.logging_steps,\n",
    "            save_steps=CFG.save_steps,\n",
    "            save_total_limit=2,\n",
    "            bf16=(DTYPE == torch.bfloat16),\n",
    "            fp16=(DTYPE == torch.float16),\n",
    "            gradient_checkpointing=True,\n",
    "            report_to='none',\n",
    "            remove_unused_columns=False,\n",
    "            num_generations=CFG.grpo_num_generations,\n",
    "            max_prompt_length=CFG.grpo_max_prompt_length,\n",
    "            max_completion_length=CFG.grpo_max_completion_length,\n",
    "            temperature=0.9,\n",
    "            top_p=0.95,\n",
    "            **hub_training_kwargs(CFG),\n",
    "        )\n",
    "        grpo_trainer = GRPOTrainer(\n",
    "            model=MODEL,\n",

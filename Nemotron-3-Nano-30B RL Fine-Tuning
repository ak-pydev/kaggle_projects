    "import importlib\n",
    "import subprocess\n",
    "import sys\n",
    "from packaging.version import Version\n",
    "\n",
    "REQUIRED_PACKAGES = {\n",
    "    'transformers': '4.47.0',\n",
    "    'trl': '0.17.0',\n",
    "    'peft': '0.14.0',\n",

    "\n",
    "\n",
    "def get_model_device(model) -> torch.device:\n",
    "    try:\n",
    "        return next(model.parameters()).device\n",
    "    except StopIteration:\n",
    "        return torch.device('cuda')\n",
    "\n",
    "\n",
    "\n",
    "def extract_strict_answer(text: str) -> Optional[str]:\n",
    "    boxed = extract_boxed(text)\n",
    "    if boxed:\n",
    "        return boxed.strip()\n",
    "\n",
    "    patterns = [\n",
    "        r'Final answer:\\s*(.+)',\n",
    "        r'The final answer is\\s+(.+)',\n",
    "        r'Answer:\\s*(.+)',\n",
    "    ]\n",
    "    for pattern in patterns:\n",
    "        match = re.search(pattern, text, re.IGNORECASE)\n",
    "        if match:\n",
    "            line = match.group(1).strip()\n",
    "            line = line.splitlines()[0].strip()\n",
    "            line = re.sub(r'[\\s\\.,;:]+$', '', line)\n",
    "            return line or None\n",
    "    return None\n",
    "\n",
    "\n",
    "def has_self_check(text: str) -> bool:\n",
    "    return any(line.strip().lower().startswith('check:') for line in text.splitlines())\n",
    "\n",
    "\n",
    "def quick_eval(model, tokenizer, problems: List[Dict], max_new_tokens: int = 512) -> float:\n",
    "    model.eval()\n",
    "    device = get_model_device(model)\n",
    "    correct = 0\n",
    "    boxed_count = 0\n",
    "    check_count = 0\n",
    "    with torch.no_grad():\n",
    "        for ex in problems:\n",
    "            prompt = render_chat(make_messages(ex['problem']), tokenizer, add_generation_prompt=True)\n",
    "            inputs = tokenizer(prompt, return_tensors='pt').to(device)\n",
    "            outputs = model.generate(\n",
    "                **inputs,\n",
    "                max_new_tokens=max_new_tokens,\n",
    "                do_sample=False,\n",
    "                pad_token_id=tokenizer.eos_token_id,\n",
    "            )\n",
    "            completion = tokenizer.decode(outputs[0][inputs['input_ids'].shape[1]:], skip_special_tokens=True)\n",
    "            strict_pred = extract_strict_answer(completion)\n",
    "            loose_pred = extract_answer(completion)\n",
    "            pred = strict_pred if strict_pred is not None else loose_pred\n",
    "            ok = answers_match(pred, ex['answer'])\n",
    "            boxed = extract_boxed(completion) is not None\n",
    "            checked = has_self_check(completion)\n",
    "            correct += int(ok)\n",
    "            boxed_count += int(boxed)\n",
    "            check_count += int(checked)\n",
    "            print(f\"Q: {ex['problem']}\")\n",
    "            print('Raw completion:')\n",
    "            print(completion[:1200] if completion.strip() else '<empty>')\n",
    "            print(f\"Strict pred: {strict_pred!r}\")\n",
    "            print(f\"Loose pred: {loose_pred!r}\")\n",
    "            print(f\"Has Check line: {checked} | Has boxed answer: {boxed}\")\n",
    "            print(f\"Pred used: {pred!r} | Gold: {ex['answer']!r} | {'OK' if ok else 'MISS'}\")\n",
    "            print()\n",
    "    acc = correct / len(problems)\n",
    "    boxed_rate = boxed_count / len(problems)\n",
    "    check_rate = check_count / len(problems)\n",
    "    print(f'Quick eval accuracy: {correct}/{len(problems)} = {acc:.1%}')\n",
    "    print(f'Boxed answer rate: {boxed_count}/{len(problems)} = {boxed_rate:.1%}')\n",
    "    print(f'Self-check rate: {check_count}/{len(problems)} = {check_rate:.1%}')\n",
    "    return acc\n",
    "\n",
    "\n",
    "print('=== Eval on fixed benchmark problems ===')\n",
    "quick_eval(MODEL, TOKENIZER, EVAL_PROBLEMS)\n",
    "\n",

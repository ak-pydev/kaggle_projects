    "def extract_boxed(text: str) -> Optional[str]:\n",
    "    idx = text.rfind(r'\\boxed{')\n",
    "    if idx == -1:\n",
    "        return None\n",
    "    start = idx + len(r'\\boxed{')\n",
    "    depth, end = 1, start\n",
    "    while end < len(text) and depth > 0:\n",
    "        if text[end] == '{':\n",
    "            depth += 1\n",
    "        elif text[end] == '}':\n",
    "            depth -= 1\n",
    "        end += 1\n",
    "    return text[start:end - 1].strip() if depth == 0 else None\n",
    "\n",
    "\n",
    "\n",
    "def extract_last_number(text: str) -> Optional[str]:\n",
    "    nums = re.findall(r'-?\\d+\\.?\\d*', text)\n",
    "    return nums[-1] if nums else None\n",
    "\n",
    "\n",
    "\n",
    "def extract_answer(text: str) -> Optional[str]:\n",
    "    ans = extract_boxed(text)\n",
    "    if ans:\n",
    "        return ans\n",
    "    for pattern in [r'(?:answer is|therefore)[:\\s]+([^\\n.]+)', r'=\\s*([^\\n=]+)$']:\n",
    "        match = re.search(pattern, text, re.IGNORECASE)\n",
    "        if match:\n",
    "            return match.group(1).strip()\n",
    "    return extract_last_number(text)\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "def latex_to_sympy_str(latex: str) -> str:\n",
    "    \"\"\"Convert common competition-math LaTeX to a SymPy-parseable string.\"\"\"\n",
    "    s = latex.strip()\n",
    "    s = re.sub(r'\\\\frac\\{([^{}]+)\\}\\{([^{}]+)\\}', r'(\\1)/(\\2)', s)\n",
    "    s = re.sub(r'\\\\sqrt\\{([^{}]+)\\}', r'sqrt(\\1)', s)\n",
    "    s = s.replace('^', '**')\n",
    "    s = re.sub(r'\\\\left|\\\\right|\\\\,|\\\\!|\\\\;', '', s)\n",
    "    s = re.sub(r'\\\\cdot', '*', s)\n",
    "    s = re.sub(r'\\\\times', '*', s)\n",
    "    s = re.sub(r'\\\\pi\\b', 'pi', s)\n",
    "    s = s.replace('{', '(').replace('}', ')')\n",
    "    return s\n",
    "\n",
    "\n",
    "def sympy_verify(pred: str, gold: str) -> bool:\n",
    "    \"\"\"Symbolically verify pred == gold using SymPy (no extra deps needed).\"\"\"\n",
    "    if pred is None or gold is None:\n",
    "        return False\n",
    "    try:\n",
    "        from sympy import sympify, simplify, N\n",
    "        p = sympify(latex_to_sympy_str(pred), rational=True)\n",
    "        g = sympify(latex_to_sympy_str(gold), rational=True)\n",
    "        diff = simplify(p - g)\n",
    "        if diff == 0:\n",
    "            return True\n",
    "        try:\n",
    "            if abs(float(N(diff, 15))) < 1e-9:\n",
    "                return True\n",
    "        except Exception:\n",
    "            pass\n",
    "    except Exception:\n",
    "        pass\n",
    "    return False\n",
    "\n",
    "def answers_match(pred: Optional[str], gold: str, tol: float = 1e-6) -> bool:\n",
    "    if pred is None:\n",
    "        return False\n",
    "    pred, gold = pred.strip(), gold.strip()\n",
    "    if pred == gold:\n",
    "        return True\n",
    "    try:\n",
    "        pred_f, gold_f = float(pred), float(gold)\n",
    "        if abs(pred_f - gold_f) / max(abs(gold_f), 1e-9) < tol:\n",
    "            return True\n",
    "    except (ValueError, ZeroDivisionError):\n",
    "        pass\n",
    "    return sympy_verify(pred, gold)\n",
    "\n",
    "\n",
    "assert extract_boxed(r'The answer is \\boxed{42}') == '42'\n",
    "assert extract_boxed(r'\\boxed{\\frac{1}{2}}') == r'\\frac{1}{2}'\n",
    "print('Answer extraction OK.')\n"
   ]

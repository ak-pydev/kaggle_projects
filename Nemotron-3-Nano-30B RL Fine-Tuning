    "    print(f'\\n=== Eval on {len(val_subset)} held-out validation examples ===')\n",
    "    quick_eval(MODEL, TOKENIZER, val_subset)\n",
    "\n",
    "\n",
    "def solve_with_self_check(problem: str, model=MODEL, tokenizer=TOKENIZER, max_new_tokens: int = 512) -> str:\n",
    "    model.eval()\n",
    "    device = get_model_device(model)\n",
    "    prompt = render_chat(make_messages(problem), tokenizer, add_generation_prompt=True)\n",
    "    inputs = tokenizer(prompt, return_tensors='pt').to(device)\n",
    "    with torch.no_grad():\n",
    "        outputs = model.generate(\n",
    "            **inputs,\n",
    "            max_new_tokens=max_new_tokens,\n",
    "            do_sample=False,\n",
    "            pad_token_id=tokenizer.eos_token_id,\n",
    "        )\n",
    "    completion = tokenizer.decode(outputs[0][inputs['input_ids'].shape[1]:], skip_special_tokens=True)\n",
    "    return completion.strip()\n",
    "\n",
    "\n",
    "print('I can now use solve_with_self_check(problem) for the final competition-style inference use case.')\n"
   ]

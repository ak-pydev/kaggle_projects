    "    {'problem': 'A rectangle has length 12 and width 7. What is its area?', 'answer': '84'},\n",
    "    {'problem': r'Simplify: $\\frac{3}{4} + \\frac{1}{6}$', 'answer': r'\\frac{11}{12}'},\n",
    "    {'problem': 'A store gives a 20% discount on a $50 item. What is the sale price?', 'answer': '40'},\n",
    "    {'problem': 'If a triangle has base 10 and height 6, what is its area?', 'answer': '30'},\n",

    "    'bitsandbytes': '0.45.0',\n",
    "    'sentencepiece': '0.2.0',\n",
    "    'huggingface_hub': '0.27.0',\n",
    "}\n",
    "\n",
    "MAMBA_PACKAGES = [\n",
    "    'causal-conv1d>=1.4.0',\n",
    "    'mamba-ssm[causal-conv1d]>=2.2.5',\n",
    "]\n",
    "\n",
    "def ensure_package(pkg_name: str, min_version: str) -> bool:\n",
    "    spec = f'{pkg_name}>={min_version}'\n",
    "    try:\n",
    "        installed = importlib.metadata.version(pkg_name)\n",
    "        if Version(installed) >= Version(min_version):\n",
    "            print(f'  {pkg_name}=={installed} already satisfied')\n",
    "            return False\n",
    "        print(f'  Upgrading {pkg_name}: {installed} -> >={min_version}')\n",
    "    except importlib.metadata.PackageNotFoundError:\n",
    "        print(f'  Installing {pkg_name} >={min_version}')\n",
    "    subprocess.check_call([sys.executable, '-m', 'pip', 'install', '-q', '--upgrade', spec])\n",
    "    return True\n",
    "\n",
    "def install_mamba_package(spec: str) -> bool:\n",
    "    base_name = spec.split('[')[0].split('>=')[0].split('==')[0]\n",
    "    min_ver_str = spec.split('>=')[-1] if '>=' in spec else '0'\n",
    "    try:\n",
    "        installed = importlib.metadata.version(base_name)\n",
    "        if Version(installed) >= Version(min_ver_str):\n",
    "            print(f'  {base_name}=={installed} already satisfied')\n",
    "            return False\n",
    "    except importlib.metadata.PackageNotFoundError:\n",
    "        pass\n",
    "\n",
    "    print(f'  Installing {spec}')\n",
    "\n",
    "    # Try prebuilt wheel first (no compilation needed)\n",
    "    result = subprocess.run(\n",
    "        [sys.executable, '-m', 'pip', 'install', '-q', spec],\n",
    "        capture_output=True\n",
    "    )\n",
    "    if result.returncode == 0:\n",
    "        return True\n",
    "\n",
    "    # Fall back to source build only if prebuilt wheel unavailable\n",
    "    print(f'  No prebuilt wheel found, attempting source build for {spec}...')\n",
    "    subprocess.check_call(\n",
    "        [sys.executable, '-m', 'pip', 'install', '-q', '--no-build-isolation', spec]\n",
    "    )\n",
    "    return True\n",
    "\n",
    "# --- Core packages ---\n",
    "print('Checking core packages...')\n",
    "changed = any(ensure_package(pkg, ver) for pkg, ver in REQUIRED_PACKAGES.items())\n",
    "\n",
    "# --- Verify torch + CUDA before Mamba ---\n",
    "print('\\nChecking torch + CUDA...')\n",
    "try:\n",
    "    import torch\n",
    "    if not torch.cuda.is_available():\n",
    "        print('WARNING: CUDA not available — Mamba packages require a GPU runtime.')\n",
    "        print('Go to Runtime > Change runtime type > T4 GPU, then rerun.')\n",
    "        sys.exit(0)\n",
    "    print(f'  torch=={torch.__version__}, CUDA={torch.version.cuda}')\n",
    "except ImportError:\n",
    "    print('ERROR: torch is not installed. Install it before Mamba packages.')\n",
    "    sys.exit(1)\n",
    "\n",
    "# --- Mamba packages ---\n",
    "print('\\nChecking Mamba packages...')\n",
    "changed |= any(install_mamba_package(spec) for spec in MAMBA_PACKAGES)\n",
    "\n",
    "# --- Restart if needed ---\n",

    "    mutated = '\\n'.join(lines)\n",
    "    if extract_boxed(mutated) is None:\n",
    "        mutated += f\"\\n\\nFinal answer: \\\\boxed{{{answer}}}\"\n",
    "    return mutated\n",
    "\n",
    "\n",
    "\n",
    "def build_preference_dataset(examples: List[Dict], tokenizer, cfg: Config) -> Dataset:\n",
    "    rows = []\n",
    "    subset = list(examples[: min(cfg.preference_subset_size, len(examples))])\n",
    "    negative_builders = [\n",
    "        mutate_solution_wrong_final,\n",
    "        mutate_solution_remove_box,\n",
    "        mutate_solution_insert_reasoning_error,\n",
    "    ]\n",
    "\n",
    "    for ex in subset:\n",
    "        prompt = render_chat(make_messages(ex['problem']), tokenizer, add_generation_prompt=False)\n",
    "        chosen = render_chat(make_messages(ex['problem'], ex['solution']), tokenizer, add_generation_prompt=False)\n",
    "        negatives = []\n",
    "        for builder in negative_builders:\n",
    "            candidate = builder(ex['solution'], ex['answer'])\n",
    "            if candidate and candidate != ex['solution']:\n",
    "                negatives.append(candidate)\n",
    "        negatives = negatives[: cfg.negatives_per_example]\n",
    "\n",
    "        for rejected_solution in negatives:\n",
    "            rejected = render_chat(make_messages(ex['problem'], rejected_solution), tokenizer, add_generation_prompt=False)\n",
    "            chosen_len = len(tokenizer(chosen, truncation=False)['input_ids'])\n",
    "            rejected_len = len(tokenizer(rejected, truncation=False)['input_ids'])\n",
    "            if max(chosen_len, rejected_len) > cfg.max_seq_length:\n",
    "                continue\n",
    "            rows.append({\n",
    "                'prompt': prompt,\n",
    "                'chosen': chosen,\n",
    "                'rejected': rejected,\n",
    "                'answer': ex['answer'],\n",
    "            })\n",
    "\n",
    "    if not rows:\n",
    "        raise RuntimeError('Preference dataset is empty. Increase CFG.max_seq_length or inspect the synthetic negative builders.')\n",
    "\n",
    "    print(f'Preference rows built: {len(rows)}')\n",
    "    return Dataset.from_list(rows)\n"
   ]

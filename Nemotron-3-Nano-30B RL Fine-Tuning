    "        solution = re.sub(r'\\\\boxed\\{.*?\\}', answer, solution, count=1)\n",
    "\n",
    "    lines = [line.rstrip() for line in solution.splitlines() if line.strip()]\n",
    "    non_check_lines = [line for line in lines if not line.strip().lower().startswith('check:')]\n",
    "    check_line = next((line for line in lines if line.strip().lower().startswith('check:')), None)\n",
    "\n",

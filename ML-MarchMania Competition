    "def optimize_weights(val_preds, n_trials=200, label=''):\n",
    "    \"\"\"\n",
    "    Find optimal ensemble weights via Optuna (or grid search fallback).\n",
    "    val_preds = (p_lr, p_xgb, p_lgb, p_elo, p_bt, y_true)\n",
    "    Returns (w_lr, w_xgb, w_lgb, w_elo, w_bt)\n",
    "    \"\"\"\n",
    "    p_lr, p_xgb, p_lgb, p_elo, p_bt, y = val_preds\n",
    "\n",
    "    def objective(weights):\n",
    "        w = np.array(weights)\n",
    "        w = w / w.sum()  # normalize\n",
    "        p = clip_prob(w[0]*p_lr + w[1]*p_xgb + w[2]*p_lgb + w[3]*p_elo + w[4]*p_bt)\n",
    "        return brier_score(y, p)\n",
    "\n",
    "    if HAS_OPTUNA:\n",
    "        def optuna_obj(trial):\n",
    "            w = [trial.suggest_float(f'w{i}', 0.0, 1.0) for i in range(5)]\n",
    "            return objective(w)\n",
    "\n",
    "        study = optuna.create_study(direction='minimize',\n",
    "                                     sampler=optuna.samplers.TPESampler(seed=SEED))\n",
    "        study.optimize(optuna_obj, n_trials=n_trials, show_progress_bar=False)\n",
    "        best = [study.best_params[f'w{i}'] for i in range(5)]\n",
    "    else:\n",
    "        # Grid search fallback\n",
    "        best_score = np.inf\n",
    "        best = [0.1, 0.35, 0.35, 0.1, 0.1]\n",
    "        for w_lr in [0.05, 0.1, 0.15, 0.2]:\n",
    "            for w_xgb in [0.25, 0.30, 0.35, 0.40]:\n",
    "                for w_lgb in [0.25, 0.30, 0.35, 0.40]:\n",
    "                    for w_elo in [0.05, 0.10, 0.15]:\n",
    "                        w_bt = max(0, 1 - w_lr - w_xgb - w_lgb - w_elo)\n",
    "                        score = objective([w_lr, w_xgb, w_lgb, w_elo, w_bt])\n",
    "                        if score < best_score:\n",
    "                            best_score = score\n",
    "                            best = [w_lr, w_xgb, w_lgb, w_elo, w_bt]\n",
    "\n",
    "    w_arr = np.array(best) / np.sum(best)\n",
    "    final_brier = objective(best)\n",
    "    print(f'{label} optimal weights: LR={w_arr[0]:.3f} XGB={w_arr[1]:.3f} '\n",
    "          f'LGB={w_arr[2]:.3f} Elo={w_arr[3]:.3f} BT={w_arr[4]:.3f}')\n",
    "    print(f'{label} val Brier: {final_brier:.4f} '\n",
    "          f'(naive 0.5: {brier_score(val_preds[5], np.full(len(val_preds[5]), 0.5)):.4f})')\n",
    "    return tuple(w_arr)\n",
    "\n",

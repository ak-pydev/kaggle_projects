    "def compute_team_stats(reg_compact, season, n_recent=10):\n",
    "    \"\"\"Basic per-team win/loss/scoring stats.\"\"\"\n",
    "    reg = reg_compact[reg_compact['Season'] == season]\n",
    "    stats = {}\n",
    "    all_teams = set(reg['WTeamID']).union(set(reg['LTeamID']))\n",
    "    reg_sorted = reg.sort_values('DayNum')\n",
    "\n",
    "    for team in all_teams:\n",
    "        wins_df   = reg_sorted[reg_sorted['WTeamID'] == team]\n",
    "        losses_df = reg_sorted[reg_sorted['LTeamID'] == team]\n",
    "        n_wins, n_losses = len(wins_df), len(losses_df)\n",
    "        n_games   = n_wins + n_losses\n",
    "\n",
    "        pts_for     = wins_df['WScore'].sum() + losses_df['LScore'].sum()\n",
    "        pts_against = wins_df['LScore'].sum() + losses_df['WScore'].sum()\n",
    "\n",
    "        w_recent = wins_df[['DayNum']].assign(Win=1)\n",
    "        l_recent = losses_df[['DayNum']].assign(Win=0)\n",
    "        recent   = pd.concat([w_recent, l_recent]).sort_values('DayNum').tail(n_recent)\n",
    "\n",
    "        stats[team] = {\n",
    "            'WinPct':       n_wins / n_games if n_games > 0 else 0.5,\n",
    "            'AvgPtDiff':    (pts_for - pts_against) / n_games if n_games > 0 else 0,\n",
    "            'AvgPtsFor':    pts_for / n_games if n_games > 0 else 0,\n",
    "            'AvgPtsAgainst':pts_against / n_games if n_games > 0 else 0,\n",
    "            'NGames':       n_games,\n",
    "            'RecentWinPct': recent['Win'].mean() if len(recent) > 0 else 0.5,\n",
    "        }\n",
    "    return pd.DataFrame(stats).T\n",
    "\n",
    "\n",
    "def compute_sos(reg_compact, elo_dict, season):\n",
    "    reg = reg_compact[reg_compact['Season'] == season]\n",
    "    sos = {}\n",
    "    for team in set(reg['WTeamID']).union(set(reg['LTeamID'])):\n",
    "        opps = (reg[reg['WTeamID'] == team]['LTeamID'].tolist() +\n",
    "                reg[reg['LTeamID'] == team]['WTeamID'].tolist())\n",
    "        sos[team] = np.mean([elo_dict.get(o, 1500) for o in opps]) if opps else 1500\n",
    "    return sos\n",
    "\n",
    "\n",
    "def get_massey_features(massey_df, season):\n",
    "    if massey_df is None or len(massey_df) == 0 or 'Season' not in massey_df.columns:\n",
    "        return {}\n",
    "    s = massey_df[massey_df['Season'] == season]\n",
    "    if len(s) == 0: return {}\n",
    "    max_day = s['RankingDayNum'].max()\n",
    "    s = s[s['RankingDayNum'] >= max_day - 14]\n",
    "    agg = s.groupby('TeamID')['OrdinalRank'].agg(['mean','min','std']).reset_index()\n",
    "    agg.columns = ['TeamID','MasseyMean','MasseyBest','MasseyStd']\n",
    "    return agg.set_index('TeamID').to_dict('index')\n",
    "\n",
    "\n",
    "def build_matchup_features(row, stats_bys, elo_bys, bt_bys, seeds_bys,\n",
    "                            massey_bys, sos_bys, ff_bys, seed_history):\n",
    "    season = int(row['Season'])\n",
    "\n",
    "    if int(row['WTeamID']) < int(row['LTeamID']):\n",
    "        teamA, teamB, label = int(row['WTeamID']), int(row['LTeamID']), 1.0\n",
    "    else:\n",
    "        teamA, teamB, label = int(row['LTeamID']), int(row['WTeamID']), 0.0\n",
    "\n",
    "    stats  = stats_bys.get(season, pd.DataFrame())\n",
    "    elo    = elo_bys.get(season, {})\n",
    "    bt     = bt_bys.get(season, {})\n",
    "    seeds  = seeds_bys.get(season, {})\n",
    "    massey = massey_bys.get(season, {})\n",
    "    sos    = sos_bys.get(season, {})\n",
    "    ff     = ff_bys.get(season, pd.DataFrame())\n",
    "\n",
    "    def gs(team, col, default=0.0):\n",
    "        if stats is None or len(stats) == 0: return default\n",
    "        if team not in stats.index or col not in stats.columns: return default\n",
    "        v = stats.loc[team, col]\n",
    "        return float(v) if pd.notna(v) else default\n",
    "\n",
    "    def gf(team, col, default=0.0):\n",
    "        if ff is None or len(ff) == 0: return default\n",
    "        if team not in ff.index or col not in ff.columns: return default\n",
    "        v = ff.loc[team, col]\n",
    "        return float(v) if pd.notna(v) else default\n",
    "\n",
    "    feat = {}\n",
    "\n",
    "    # ── Elo ───────────────────────────────────────────────────────────────────\n",
    "    elo_A = elo.get(teamA, 1500); elo_B = elo.get(teamB, 1500)\n",
    "    feat['EloDiff']    = elo_A - elo_B\n",
    "    feat['EloWinProb'] = 1 / (1 + 10 ** ((elo_B - elo_A) / 400))\n",
    "\n",
    "    # ── Bradley-Terry ─────────────────────────────────────────────────────────\n",
    "    bt_A = bt.get(teamA, 0.0); bt_B = bt.get(teamB, 0.0)\n",
    "    feat['BTDiff']    = bt_A - bt_B\n",
    "    feat['BTWinProb'] = float(expit(bt_A - bt_B))\n",
    "\n",
    "    # ── Seeds ─────────────────────────────────────────────────────────────────\n",
    "    seed_A = seeds.get(teamA, 16); seed_B = seeds.get(teamB, 16)\n",
    "    if pd.isna(seed_A): seed_A = 16\n",
    "    if pd.isna(seed_B): seed_B = 16\n",
    "    seed_A, seed_B = int(seed_A), int(seed_B)\n",
    "    feat['SeedDiff']  = seed_A - seed_B\n",
    "    feat['SeedA']     = seed_A\n",
    "    feat['SeedB']     = seed_B\n",
    "\n",
    "    # Seed interaction: historical win rate for this seed matchup\n",
    "    s_lo, s_hi = min(seed_A, seed_B), max(seed_A, seed_B)\n",
    "    hist_rate  = seed_history.get((s_lo, s_hi), 0.5)\n",
    "    # hist_rate = P(lower seed wins); flip if teamA is the higher seed\n",
    "    feat['SeedHistWinProb'] = hist_rate if seed_A <= seed_B else (1 - hist_rate)\n",
    "\n",
    "    # Upset-line dummies (5v12, 8v9, etc.)\n",
    "    for a, b in [(1,16),(2,15),(3,14),(4,13),(5,12),(6,11),(7,10),(8,9)]:\n",
    "        feat[f'IsLine_{a}v{b}'] = 1 if (s_lo == a and s_hi == b) else 0\n",
    "\n",
    "    # ── Basic stats ───────────────────────────────────────────────────────────\n",
    "    for col in ['WinPct','AvgPtDiff','RecentWinPct','AvgPtsFor','AvgPtsAgainst']:\n",
    "        a, b = gs(teamA, col), gs(teamB, col)\n",
    "        feat[f'{col}Diff'] = a - b\n",
    "        feat[f'{col}_A']   = a\n",
    "        feat[f'{col}_B']   = b\n",
    "\n",
    "    # ── KenPom Four Factors ───────────────────────────────────────────────────\n",
    "    for col in ['eFGpct','TOVpct','ORBpct','FTR','FTpct',\n",
    "                'def_eFGpct','def_TOVpct','def_FTR',\n",
    "                'OffEff','DefEff','AdjEM','Pace']:\n",
    "        a, b = gf(teamA, col), gf(teamB, col)\n",
    "        feat[f'{col}Diff'] = a - b\n",
    "        feat[f'{col}_A']   = a\n",
    "        feat[f'{col}_B']   = b\n",
    "\n",
    "    # ── Massey ordinals ───────────────────────────────────────────────────────\n",
    "    mA = massey.get(teamA, {}).get('MasseyMean', 200)\n",
    "    mB = massey.get(teamB, {}).get('MasseyMean', 200)\n",
    "    feat['MasseyRankDiff'] = mA - mB  # positive = A is ranked worse\n",
    "\n",
    "    # ── SOS ───────────────────────────────────────────────────────────────────\n",
    "    feat['SOSDiff'] = sos.get(teamA, 1500) - sos.get(teamB, 1500)\n",
    "\n",
    "    feat['Season'] = season\n",
    "    feat['TeamA']  = teamA\n",
    "    feat['TeamB']  = teamB\n",
    "    feat['Label']  = label\n",
    "    return feat\n",
    "\n",
    "\n",
    "print('Feature builder v2 defined ✓')"

    "def estimate_possessions(fga, fta, orb, to):\n",
    "    \"\"\"Dean Oliver possession estimate.\"\"\"\n",
    "    return fga - orb + to + 0.44 * fta\n",
    "\n",
    "\n",
    "def compute_four_factors(reg_detail, tourn_detail, season):\n",
    "    \"\"\"\n",
    "    Returns DataFrame with KenPom Four Factors per team.\n",
    "    Works even if detail DataFrames are empty.\n",
    "    \"\"\"\n",
    "    dfs = []\n",
    "    for df in [reg_detail, tourn_detail]:\n",
    "        if df is not None and len(df) > 0 and 'Season' in df.columns:\n",
    "            dfs.append(df[df['Season'] == season])\n",
    "    if not dfs:\n",
    "        return pd.DataFrame()\n",
    "\n",
    "    detail = pd.concat(dfs, ignore_index=True)\n",
    "    if len(detail) == 0:\n",
    "        return pd.DataFrame()\n",
    "\n",
    "    records = {}\n",
    "    all_teams = set(detail['WTeamID']).union(set(detail['LTeamID']))\n",
    "\n",
    "    for team in all_teams:\n",
    "        w = detail[detail['WTeamID'] == team]\n",
    "        l = detail[detail['LTeamID'] == team]\n",
    "\n",
    "        # Offense (team's own stats)\n",
    "        off_fgm  = w['WFGM'].sum()  + l['LFGM'].sum()\n",
    "        off_fga  = w['WFGA'].sum()  + l['LFGA'].sum()\n",
    "        off_fgm3 = w['WFGM3'].sum() + l['LFGM3'].sum()\n",
    "        off_fta  = w['WFTA'].sum()  + l['LFTA'].sum()\n",
    "        off_ftm  = w['WFTM'].sum()  + l['LFTM'].sum()\n",
    "        off_orb  = w['WOR'].sum()   + l['LOR'].sum()\n",
    "        off_drb  = w['WDR'].sum()   + l['LDR'].sum()\n",
    "        off_to   = w['WTO'].sum()   + l['LTO'].sum()\n",
    "        off_pts  = w['WScore'].sum() + l['LScore'].sum()\n",
    "\n",
    "        # Defense (opponent's stats)\n",
    "        def_fgm  = w['LFGM'].sum()  + l['WFGM'].sum()\n",
    "        def_fga  = w['LFGA'].sum()  + l['WFGA'].sum()\n",
    "        def_fgm3 = w['LFGM3'].sum() + l['WFGM3'].sum()\n",
    "        def_fta  = w['LFTA'].sum()  + l['WFTA'].sum()\n",
    "        def_orb  = w['LOR'].sum()   + l['WOR'].sum()\n",
    "        def_to   = w['LTO'].sum()   + l['WTO'].sum()\n",
    "        def_pts  = w['LScore'].sum() + l['WScore'].sum()\n",
    "\n",
    "        n_games = len(w) + len(l)\n",
    "        if n_games == 0 or off_fga == 0:\n",
    "            continue\n",
    "\n",
    "        # Offensive possessions\n",
    "        off_poss = estimate_possessions(off_fga, off_fta, off_orb, off_to)\n",
    "        def_poss = estimate_possessions(def_fga, def_fta, def_orb, def_to)\n",
    "\n",
    "        off_eff = (off_pts / off_poss * 100) if off_poss > 0 else 100\n",
    "        def_eff = (def_pts / def_poss * 100) if def_poss > 0 else 100\n",
    "\n",
    "        records[team] = {\n",
    "            # Four factors — offense\n",
    "            'eFGpct':   (off_fgm + 0.5 * off_fgm3) / off_fga if off_fga > 0 else 0,\n",
    "            'TOVpct':   off_to / off_poss * 100 if off_poss > 0 else 20,\n",
    "            'ORBpct':   off_orb / (off_orb + def_drb if 'def_drb' in dir() else off_orb + 1) ,\n",
    "            'FTR':      off_fta / off_fga if off_fga > 0 else 0,\n",
    "            'FTpct':    off_ftm / off_fta if off_fta > 0 else 0,\n",
    "            # Four factors — defense (opponent's)\n",
    "            'def_eFGpct': (def_fgm + 0.5 * def_fgm3) / def_fga if def_fga > 0 else 0,\n",
    "            'def_TOVpct': def_to / def_poss * 100 if def_poss > 0 else 20,\n",
    "            'def_FTR':    def_fta / def_fga if def_fga > 0 else 0,\n",
    "            # Efficiency\n",
    "            'OffEff':   off_eff,\n",
    "            'DefEff':   def_eff,\n",
    "            'AdjEM':    off_eff - def_eff,  # proxy (not schedule-adjusted)\n",
    "            'Pace':     (off_poss + def_poss) / (2 * n_games) if n_games > 0 else 70,\n",
    "        }\n",
    "\n",
    "    return pd.DataFrame(records).T\n",
    "\n",
    "\n",
    "print('Computing Four Factors for 2026...')\n",
    "m_ff_2026 = compute_four_factors(m_reg_detail, m_tourn_detail, TARGET_SEASON)\n",
    "w_ff_2026 = compute_four_factors(w_reg_detail, w_tourn_detail, TARGET_SEASON)\n",
    "print(f'Men\\'s four factors: {m_ff_2026.shape}')\n",
    "print(f'Women\\'s four factors: {w_ff_2026.shape}')\n",
    "if len(m_ff_2026):\n",
    "    print(m_ff_2026.sort_values('AdjEM', ascending=False).head(5)[['AdjEM','OffEff','DefEff','eFGpct','TOVpct']])"
   ]

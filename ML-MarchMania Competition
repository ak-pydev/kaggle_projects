    "def predict_submission_v2(sample_sub,\n",
    "                           m_stats, m_elo, m_bt, m_seeds, m_massey, m_sos, m_ff,\n",
    "                           w_stats, w_elo, w_bt, w_seeds, w_massey, w_sos, w_ff,\n",
    "                           m_lr, m_xgb, m_lgb, m_weights, m_iso, m_seed_hist,\n",
    "                           w_lr, w_xgb, w_lgb, w_weights, w_iso, w_seed_hist,\n",
    "                           feature_cols):\n",
    "    rows = []\n",
    "\n",
    "    for _, row in sample_sub.iterrows():\n",
    "        parts   = row['ID'].split('_')\n",
    "        season  = int(parts[0])\n",
    "        team_a  = int(parts[1])\n",
    "        team_b  = int(parts[2])\n",
    "        is_w    = (team_a >= 3000)\n",
    "\n",
    "        # Select gender-specific lookups\n",
    "        stats_d  = {season: w_stats  if is_w else m_stats}\n",
    "        elo_d    = {season: w_elo    if is_w else m_elo}\n",
    "        bt_d     = {season: w_bt     if is_w else m_bt}\n",
    "        seeds_d  = {season: w_seeds  if is_w else m_seeds}\n",
    "        massey_d = {season: w_massey if is_w else m_massey}\n",
    "        sos_d    = {season: w_sos    if is_w else m_sos}\n",
    "        ff_d     = {season: w_ff     if is_w else m_ff}\n",
    "        sh       = w_seed_hist if is_w else m_seed_hist\n",
    "        lr_m     = w_lr  if is_w else m_lr\n",
    "        xgb_m    = w_xgb if is_w else m_xgb\n",
    "        lgb_m    = w_lgb if is_w else m_lgb\n",
    "        iso      = w_iso if is_w else m_iso\n",
    "        weights  = w_weights if is_w else m_weights\n",
    "        elo_flat = w_elo if is_w else m_elo\n",
    "        bt_flat  = w_bt  if is_w else m_bt\n",
    "\n",
    "        fake_row = pd.Series({\n",
    "            'Season': season, 'WTeamID': team_a, 'LTeamID': team_b,\n",
    "            'WScore': 70, 'LScore': 65\n",
    "        })\n",
    "\n",
    "        feat = build_matchup_features(\n",
    "            fake_row, stats_d, elo_d, bt_d, seeds_d, massey_d, sos_d, ff_d, sh)\n",
    "\n",
    "        x = np.array([feat.get(c, 0.0) for c in feature_cols], dtype=float).reshape(1, -1)\n",
    "\n",
    "        p_lr_  = lr_m.predict_proba(x)[0, 1]\n",
    "        p_xgb_ = xgb_m.predict_proba(x)[0, 1]\n",
    "        p_lgb_ = lgb_m.predict_proba(x)[0, 1]\n",
    "\n",
    "        elo_a = elo_flat.get(team_a, 1500)\n",
    "        elo_b = elo_flat.get(team_b, 1500)\n",
    "        p_elo_ = 1 / (1 + 10 ** ((elo_b - elo_a) / 400))\n",
    "\n",
    "        bt_a = bt_flat.get(team_a, 0.0)\n",
    "        bt_b = bt_flat.get(team_b, 0.0)\n",
    "        p_bt_ = float(expit(bt_a - bt_b))\n",
    "\n",
    "        w = np.array(weights)\n",
    "        p_ens = clip_prob(w[0]*p_lr_ + w[1]*p_xgb_ + w[2]*p_lgb_ + w[3]*p_elo_ + w[4]*p_bt_)\n",
    "\n",
    "        # Isotonic calibration\n",
    "        p_final = float(clip_prob(iso.predict([p_ens])[0]))\n",
    "\n",
    "        rows.append({'ID': row['ID'], 'Pred': p_final})\n",
    "\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "print('Generating final predictions...')\n",
    "submission = predict_submission_v2(\n",
    "    sample_sub,\n",
    "    m_stats_2026, m_elo_2026, m_bt, m_seeds_2026, m_massey_2026, m_sos_2026, m_ff_2026,\n",
    "    w_stats_2026, w_elo_2026, w_bt, w_seeds_2026, w_massey_2026, w_sos_2026, w_ff_2026,\n",
    "    m_lr, m_xgb, m_lgb, m_weights, m_iso, m_seed_history,\n",
    "    w_lr, w_xgb, w_lgb, w_weights, w_iso, w_seed_history,\n",
    "    FEATURE_COLS\n",
    ")\n",
    "\n",
    "print(f'Submission shape: {submission.shape}')\n",
    "print(f'Pred range: {submission[\"Pred\"].min():.4f} – {submission[\"Pred\"].max():.4f}')\n",
    "print(f'Pred mean:  {submission[\"Pred\"].mean():.4f}')\n",
    "submission.head(10)"
   ]

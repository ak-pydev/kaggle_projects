{"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.12.12"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceType":"competition","sourceId":130469,"databundleVersionId":16119586,"isSourceIdPinned":false}],"dockerImageVersionId":31329,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":true}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"markdown","source":"# 🏀 March Machine Learning Mania 2026 \n\n**Improvements over v1:**\n1.  **KenPom-style features** — eFG%, TOV%, ORB%, FTR, pace, AdjEM proxy\n2.  **Seed interaction features** — upset-line dummies, seed-line history, conference per seed\n3.  **Optuna ensemble weight tuning** — Bayesian optimization on held-out seasons 2018–2025\n4.  **Isotonic calibration** — replace raw ensemble with leave-one-season-out calibrated output\n5.  **Separate Men's / Women's models** — independently trained XGB+LGB per gender\n6.  **Recency-decayed Elo** — last-30-day games weighted 2x in K-factor\n7.  **Massey ordinals graceful fallback** — works even when WMasseyOrdinals.csv is missing","metadata":{}},{"cell_type":"markdown","source":"## 1. Setup & Imports","metadata":{}},{"cell_type":"code","source":"import os, re, warnings\nwarnings.filterwarnings('ignore')\n\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom scipy.special import expit\nfrom scipy.optimize import minimize\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.isotonic import IsotonicRegression\nfrom sklearn.pipeline import Pipeline\nfrom sklearn.model_selection import cross_val_score\nimport xgboost as xgb\nimport lightgbm as lgb\n\ntry:\n    import optuna\n    optuna.logging.set_verbosity(optuna.logging.WARNING)\n    HAS_OPTUNA = True\nexcept ImportError:\n    HAS_OPTUNA = False\n    print('optuna not found — will use grid search for weight tuning')\n\nDATA_DIR = Path('/kaggle/input/march-machine-learning-mania-2026')\nOUT_DIR  = Path('/kaggle/working')\nSEED     = 42\nTARGET_SEASON = 2026\nnp.random.seed(SEED)\nprint('Libraries loaded ✓')","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 2. Load Data","metadata":{}},{"cell_type":"code","source":"def load(fname):\n    p = DATA_DIR / fname\n    if p.exists():\n        return pd.read_csv(p)\n    for f in DATA_DIR.iterdir():\n        if f.name.lower() == fname.lower():\n            return pd.read_csv(f)\n    print(f'WARNING: {fname} not found — empty DataFrame')\n    return pd.DataFrame()\n\nm_teams         = load('MTeams.csv')\nm_reg_compact   = load('MRegularSeasonCompactResults.csv')\nm_tourn_compact = load('MNCAATourneyCompactResults.csv')\nm_reg_detail    = load('MRegularSeasonDetailedResults.csv')\nm_tourn_detail  = load('MNCAATourneyDetailedResults.csv')\nm_seeds         = load('MNCAATourneySeeds.csv')\nm_massey        = load('MMasseyOrdinals.csv')\nm_conferences   = load('MTeamConferences.csv')\n\nw_teams         = load('WTeams.csv')\nw_reg_compact   = load('WRegularSeasonCompactResults.csv')\nw_tourn_compact = load('WNCAATourneyCompactResults.csv')\nw_reg_detail    = load('WRegularSeasonDetailedResults.csv')\nw_tourn_detail  = load('WNCAATourneyDetailedResults.csv')\nw_seeds         = load('WNCAATourneySeeds.csv')\nw_massey        = load('WMasseyOrdinals.csv')  # may be empty — handled gracefully\nw_conferences   = load('WTeamConferences.csv')\n\nsample_sub = load('SampleSubmissionStage2.csv')\n\nfor name, df in [('m_reg_compact', m_reg_compact), ('m_tourn_compact', m_tourn_compact),\n                  ('w_reg_compact', w_reg_compact), ('w_tourn_compact', w_tourn_compact),\n                  ('sample_sub', sample_sub)]:\n    print(f'{name}: {df.shape}')","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 3. Helpers","metadata":{}},{"cell_type":"code","source":"def parse_seed(seed_str):\n    if pd.isna(seed_str): return 16\n    m = re.search(r'(\\d+)', str(seed_str))\n    return int(m.group(1)) if m else 16\n\ndef brier_score(y_true, y_pred):\n    return float(np.mean((np.array(y_pred) - np.array(y_true)) ** 2))\n\ndef clip_prob(p, eps=0.025):\n    return np.clip(p, eps, 1 - eps)\n\ndef safe_concat(dfs):\n    valid = [d for d in dfs if d is not None and len(d) > 0 and 'Season' in d.columns]\n    if not valid:\n        return pd.DataFrame(columns=['Season','DayNum','WTeamID','LTeamID','WScore','LScore'])\n    return pd.concat(valid, ignore_index=True)\n\nprint('Helpers defined ✓')","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 4. Elo with Recency Decay\n\n**Improvement:** Games in the **last 30 days** of the regular season (Day 118+) get a 2× K-factor boost — the team you are heading into the tournament matters more than October games.","metadata":{}},{"cell_type":"code","source":"REGULAR_SEASON_END_DAY = 118  # approx last day before conference tourneys\nRECENCY_WINDOW = 30           # days before end of regular season to boost\nRECENCY_K_MULT = 2.0          # K multiplier for recent games\n\ndef compute_elo(games_df, initial_elo=1500, K=20, carry_over=0.75, margin_weight=True):\n    \"\"\"\n    Elo with:\n    - Margin-of-victory K scaling (538/Silver style)\n    - Recency decay: late-season games count 2x\n    - Season carry-over with regression to mean\n    \"\"\"\n    elo = {}\n    season_end_elo = {}\n\n    games_sorted = games_df.sort_values(['Season', 'DayNum']).reset_index(drop=True)\n    current_season = None\n\n    for _, row in games_sorted.iterrows():\n        season  = int(row['Season'])\n        day_num = int(row['DayNum'])\n\n        if season != current_season:\n            if current_season is not None:\n                season_end_elo[current_season] = dict(elo)\n                for tid in elo:\n                    elo[tid] = carry_over * elo[tid] + (1 - carry_over) * initial_elo\n            current_season = season\n\n        w = int(row['WTeamID'])\n        l = int(row['LTeamID'])\n        ws = float(row['WScore']) if 'WScore' in row.index and pd.notna(row['WScore']) else 0.0\n        ls = float(row['LScore']) if 'LScore' in row.index and pd.notna(row['LScore']) else 0.0\n\n        elo.setdefault(w, initial_elo)\n        elo.setdefault(l, initial_elo)\n\n        ew, el_ = elo[w], elo[l]\n        exp_w = 1.0 / (1.0 + 10.0 ** ((el_ - ew) / 400.0))\n\n        # Base K\n        k = float(K)\n\n        # MOV multiplier\n        if margin_weight and ws > 0 and ls > 0:\n            mov      = abs(ws - ls)\n            elo_diff = abs(ew - el_)\n            k *= np.log1p(mov) * (2.2 / (elo_diff * 0.001 + 2.2))\n\n        # Recency boost for late regular season & tournament games\n        if day_num >= (REGULAR_SEASON_END_DAY - RECENCY_WINDOW):\n            k *= RECENCY_K_MULT\n\n        elo[w] += k * (1.0 - exp_w)\n        elo[l] += k * (0.0 - (1.0 - exp_w))\n\n    if current_season is not None:\n        season_end_elo[current_season] = dict(elo)\n\n    return season_end_elo\n\n\nm_all_games = safe_concat([m_reg_compact, m_tourn_compact])\nw_all_games = safe_concat([w_reg_compact, w_tourn_compact])\n\nm_elo_by_season = compute_elo(m_all_games, K=20)\nw_elo_by_season = compute_elo(w_all_games, K=20)\n\ndisplay_season = TARGET_SEASON if TARGET_SEASON in m_elo_by_season else max(m_elo_by_season)\ntop = sorted(m_elo_by_season[display_season].items(), key=lambda x: -x[1])[:10]\ntop_df = pd.DataFrame(top, columns=['TeamID','Elo'])\ntop_df = top_df.merge(m_teams[['TeamID','TeamName']], on='TeamID', how='left')\nprint(f\"Top 10 Men's Elo (end of {display_season}):\")\nprint(top_df.to_string(index=False))\nprint('\\nElo computed ✓')","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 5. Bradley-Terry Model","metadata":{}},{"cell_type":"code","source":"def fit_bradley_terry(games_df, team_ids, n_iter=500, tol=1e-6):\n    teams = list(team_ids)\n    idx   = {t: i for i, t in enumerate(teams)}\n    n     = len(teams)\n    wins  = np.zeros((n, n))\n    games = np.zeros((n, n))\n\n    for _, row in games_df.iterrows():\n        w, l = int(row['WTeamID']), int(row['LTeamID'])\n        if w not in idx or l not in idx: continue\n        i, j = idx[w], idx[l]\n        wins[i, j]  += 1\n        games[i, j] += 1\n        games[j, i] += 1\n\n    p = np.ones(n)\n    for _ in range(n_iter):\n        p_old = p.copy()\n        W     = wins.sum(axis=1)\n        denom = np.zeros(n)\n        for i in range(n):\n            for j in range(n):\n                if games[i, j] > 0:\n                    denom[i] += games[i, j] / (p[i] + p[j])\n        p = W / (denom + 1e-10)\n        p /= p.mean()\n        if np.max(np.abs(p - p_old)) < tol: break\n\n    return {teams[i]: np.log(p[i] + 1e-10) for i in range(n)}\n\n\ndef get_bt_for_season(reg_df, tourn_df, season):\n    reg_s        = reg_df[reg_df['Season'] == season]\n    tourn_prior  = tourn_df[tourn_df['Season'] < season]\n    games        = pd.concat([reg_s, tourn_prior], ignore_index=True)\n    team_ids     = set(games['WTeamID']).union(set(games['LTeamID']))\n    return fit_bradley_terry(games, team_ids)\n\n\nprint('Fitting BT for Men\\'s...')\nm_bt = get_bt_for_season(m_reg_compact, m_tourn_compact, TARGET_SEASON)\nprint('Fitting BT for Women\\'s...')\nw_bt = get_bt_for_season(w_reg_compact, w_tourn_compact, TARGET_SEASON)\nprint(f'BT done — {len(m_bt)} men\\'s, {len(w_bt)} women\\'s teams ✓')","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 6. KenPom-Style Features\n\n**Improvement:** Compute Four Factors + tempo from detailed box scores:\n- **eFG%** — effective field goal % (weights 3-pointers appropriately)\n- **TOV%** — turnover rate (turnovers per 100 possessions)\n- **ORB%** — offensive rebound rate\n- **FTR** — free throw rate (FTA/FGA)\n- **Pace** — estimated possessions per game\n- **AdjEM proxy** — (OffEff - DefEff), where efficiency = pts per 100 possessions","metadata":{}},{"cell_type":"code","source":"def estimate_possessions(fga, fta, orb, to):\n    \"\"\"Dean Oliver possession estimate.\"\"\"\n    return fga - orb + to + 0.44 * fta\n\n\ndef compute_four_factors(reg_detail, tourn_detail, season):\n    \"\"\"\n    Returns DataFrame with KenPom Four Factors per team.\n    Works even if detail DataFrames are empty.\n    \"\"\"\n    dfs = []\n    for df in [reg_detail, tourn_detail]:\n        if df is not None and len(df) > 0 and 'Season' in df.columns:\n            dfs.append(df[df['Season'] == season])\n    if not dfs:\n        return pd.DataFrame()\n\n    detail = pd.concat(dfs, ignore_index=True)\n    if len(detail) == 0:\n        return pd.DataFrame()\n\n    records = {}\n    all_teams = set(detail['WTeamID']).union(set(detail['LTeamID']))\n\n    for team in all_teams:\n        w = detail[detail['WTeamID'] == team]\n        l = detail[detail['LTeamID'] == team]\n\n        # Offense (team's own stats)\n        off_fgm  = w['WFGM'].sum()  + l['LFGM'].sum()\n        off_fga  = w['WFGA'].sum()  + l['LFGA'].sum()\n        off_fgm3 = w['WFGM3'].sum() + l['LFGM3'].sum()\n        off_fta  = w['WFTA'].sum()  + l['LFTA'].sum()\n        off_ftm  = w['WFTM'].sum()  + l['LFTM'].sum()\n        off_orb  = w['WOR'].sum()   + l['LOR'].sum()\n        off_drb  = w['WDR'].sum()   + l['LDR'].sum()\n        off_to   = w['WTO'].sum()   + l['LTO'].sum()\n        off_pts  = w['WScore'].sum() + l['LScore'].sum()\n\n        # Defense (opponent's stats)\n        def_fgm  = w['LFGM'].sum()  + l['WFGM'].sum()\n        def_fga  = w['LFGA'].sum()  + l['WFGA'].sum()\n        def_fgm3 = w['LFGM3'].sum() + l['WFGM3'].sum()\n        def_fta  = w['LFTA'].sum()  + l['WFTA'].sum()\n        def_orb  = w['LOR'].sum()   + l['WOR'].sum()\n        def_to   = w['LTO'].sum()   + l['WTO'].sum()\n        def_pts  = w['LScore'].sum() + l['WScore'].sum()\n\n        n_games = len(w) + len(l)\n        if n_games == 0 or off_fga == 0:\n            continue\n\n        # Offensive possessions\n        off_poss = estimate_possessions(off_fga, off_fta, off_orb, off_to)\n        def_poss = estimate_possessions(def_fga, def_fta, def_orb, def_to)\n\n        off_eff = (off_pts / off_poss * 100) if off_poss > 0 else 100\n        def_eff = (def_pts / def_poss * 100) if def_poss > 0 else 100\n\n        records[team] = {\n            # Four factors — offense\n            'eFGpct':   (off_fgm + 0.5 * off_fgm3) / off_fga if off_fga > 0 else 0,\n            'TOVpct':   off_to / off_poss * 100 if off_poss > 0 else 20,\n            'ORBpct':   off_orb / (off_orb + def_drb if 'def_drb' in dir() else off_orb + 1) ,\n            'FTR':      off_fta / off_fga if off_fga > 0 else 0,\n            'FTpct':    off_ftm / off_fta if off_fta > 0 else 0,\n            # Four factors — defense (opponent's)\n            'def_eFGpct': (def_fgm + 0.5 * def_fgm3) / def_fga if def_fga > 0 else 0,\n            'def_TOVpct': def_to / def_poss * 100 if def_poss > 0 else 20,\n            'def_FTR':    def_fta / def_fga if def_fga > 0 else 0,\n            # Efficiency\n            'OffEff':   off_eff,\n            'DefEff':   def_eff,\n            'AdjEM':    off_eff - def_eff,  # proxy (not schedule-adjusted)\n            'Pace':     (off_poss + def_poss) / (2 * n_games) if n_games > 0 else 70,\n        }\n\n    return pd.DataFrame(records).T\n\n\nprint('Computing Four Factors for 2026...')\nm_ff_2026 = compute_four_factors(m_reg_detail, m_tourn_detail, TARGET_SEASON)\nw_ff_2026 = compute_four_factors(w_reg_detail, w_tourn_detail, TARGET_SEASON)\nprint(f'Men\\'s four factors: {m_ff_2026.shape}')\nprint(f'Women\\'s four factors: {w_ff_2026.shape}')\nif len(m_ff_2026):\n    print(m_ff_2026.sort_values('AdjEM', ascending=False).head(5)[['AdjEM','OffEff','DefEff','eFGpct','TOVpct']])","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 7. Seed Interaction Features\n\n**Improvement:** Historical seed matchup win rates encode tournament structure that raw seed numbers miss (e.g., 5-seeds historically lose to 12-seeds at ~36%).","metadata":{}},{"cell_type":"code","source":"def build_seed_history(tourn_compact, seeds_df):\n    \"\"\"\n    Compute historical win rate for each (seed_low, seed_high) matchup pair.\n    Returns dict: (seed_a, seed_b) → P(seed_a wins), where seed_a < seed_b numerically.\n    \"\"\"\n    seeds_map = {}\n    for _, r in seeds_df.iterrows():\n        seeds_map[(int(r['Season']), int(r['TeamID']))] = parse_seed(r['Seed'])\n\n    matchup_wins  = {}\n    matchup_total = {}\n\n    for _, r in tourn_compact.iterrows():\n        s  = int(r['Season'])\n        wt = int(r['WTeamID'])\n        lt = int(r['LTeamID'])\n        sw = seeds_map.get((s, wt), 16)\n        sl = seeds_map.get((s, lt), 16)\n        if pd.isna(sw) or pd.isna(sl): continue\n        sw, sl = int(sw), int(sl)\n\n        # Canonical: lower seed number = better seed\n        key = (min(sw, sl), max(sw, sl))\n        matchup_total[key] = matchup_total.get(key, 0) + 1\n        # Did the lower (better) seed win?\n        if sw < sl:  # winner had better seed\n            matchup_wins[key] = matchup_wins.get(key, 0) + 1\n\n    hist = {}\n    for key, total in matchup_total.items():\n        wins = matchup_wins.get(key, 0)\n        # Laplace smoothing with prior of 0.5\n        hist[key] = (wins + 2) / (total + 4)\n\n    return hist\n\n\nm_seed_history = build_seed_history(m_tourn_compact, m_seeds)\nw_seed_history = build_seed_history(w_tourn_compact, w_seeds)\n\n# Show classic upsets\nupset_lines = [(5,12),(6,11),(7,10),(8,9),(1,16),(2,15),(3,14),(4,13)]\nprint('Historical upset rates (men\\'s):')\nfor a, b in upset_lines:\n    rate = m_seed_history.get((a,b), 0.5)\n    print(f'  #{a} vs #{b}: {rate:.1%} chance #{a} wins')\nprint('Seed history built ✓')","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 8. Full Feature Builder (v2)","metadata":{}},{"cell_type":"code","source":"def compute_team_stats(reg_compact, season, n_recent=10):\n    \"\"\"Basic per-team win/loss/scoring stats.\"\"\"\n    reg = reg_compact[reg_compact['Season'] == season]\n    stats = {}\n    all_teams = set(reg['WTeamID']).union(set(reg['LTeamID']))\n    reg_sorted = reg.sort_values('DayNum')\n\n    for team in all_teams:\n        wins_df   = reg_sorted[reg_sorted['WTeamID'] == team]\n        losses_df = reg_sorted[reg_sorted['LTeamID'] == team]\n        n_wins, n_losses = len(wins_df), len(losses_df)\n        n_games   = n_wins + n_losses\n\n        pts_for     = wins_df['WScore'].sum() + losses_df['LScore'].sum()\n        pts_against = wins_df['LScore'].sum() + losses_df['WScore'].sum()\n\n        w_recent = wins_df[['DayNum']].assign(Win=1)\n        l_recent = losses_df[['DayNum']].assign(Win=0)\n        recent   = pd.concat([w_recent, l_recent]).sort_values('DayNum').tail(n_recent)\n\n        stats[team] = {\n            'WinPct':       n_wins / n_games if n_games > 0 else 0.5,\n            'AvgPtDiff':    (pts_for - pts_against) / n_games if n_games > 0 else 0,\n            'AvgPtsFor':    pts_for / n_games if n_games > 0 else 0,\n            'AvgPtsAgainst':pts_against / n_games if n_games > 0 else 0,\n            'NGames':       n_games,\n            'RecentWinPct': recent['Win'].mean() if len(recent) > 0 else 0.5,\n        }\n    return pd.DataFrame(stats).T\n\n\ndef compute_sos(reg_compact, elo_dict, season):\n    reg = reg_compact[reg_compact['Season'] == season]\n    sos = {}\n    for team in set(reg['WTeamID']).union(set(reg['LTeamID'])):\n        opps = (reg[reg['WTeamID'] == team]['LTeamID'].tolist() +\n                reg[reg['LTeamID'] == team]['WTeamID'].tolist())\n        sos[team] = np.mean([elo_dict.get(o, 1500) for o in opps]) if opps else 1500\n    return sos\n\n\ndef get_massey_features(massey_df, season):\n    if massey_df is None or len(massey_df) == 0 or 'Season' not in massey_df.columns:\n        return {}\n    s = massey_df[massey_df['Season'] == season]\n    if len(s) == 0: return {}\n    max_day = s['RankingDayNum'].max()\n    s = s[s['RankingDayNum'] >= max_day - 14]\n    agg = s.groupby('TeamID')['OrdinalRank'].agg(['mean','min','std']).reset_index()\n    agg.columns = ['TeamID','MasseyMean','MasseyBest','MasseyStd']\n    return agg.set_index('TeamID').to_dict('index')\n\n\ndef build_matchup_features(row, stats_bys, elo_bys, bt_bys, seeds_bys,\n                            massey_bys, sos_bys, ff_bys, seed_history):\n    season = int(row['Season'])\n\n    if int(row['WTeamID']) < int(row['LTeamID']):\n        teamA, teamB, label = int(row['WTeamID']), int(row['LTeamID']), 1.0\n    else:\n        teamA, teamB, label = int(row['LTeamID']), int(row['WTeamID']), 0.0\n\n    stats  = stats_bys.get(season, pd.DataFrame())\n    elo    = elo_bys.get(season, {})\n    bt     = bt_bys.get(season, {})\n    seeds  = seeds_bys.get(season, {})\n    massey = massey_bys.get(season, {})\n    sos    = sos_bys.get(season, {})\n    ff     = ff_bys.get(season, pd.DataFrame())\n\n    def gs(team, col, default=0.0):\n        if stats is None or len(stats) == 0: return default\n        if team not in stats.index or col not in stats.columns: return default\n        v = stats.loc[team, col]\n        return float(v) if pd.notna(v) else default\n\n    def gf(team, col, default=0.0):\n        if ff is None or len(ff) == 0: return default\n        if team not in ff.index or col not in ff.columns: return default\n        v = ff.loc[team, col]\n        return float(v) if pd.notna(v) else default\n\n    feat = {}\n\n    # ── Elo ───────────────────────────────────────────────────────────────────\n    elo_A = elo.get(teamA, 1500); elo_B = elo.get(teamB, 1500)\n    feat['EloDiff']    = elo_A - elo_B\n    feat['EloWinProb'] = 1 / (1 + 10 ** ((elo_B - elo_A) / 400))\n\n    # ── Bradley-Terry ─────────────────────────────────────────────────────────\n    bt_A = bt.get(teamA, 0.0); bt_B = bt.get(teamB, 0.0)\n    feat['BTDiff']    = bt_A - bt_B\n    feat['BTWinProb'] = float(expit(bt_A - bt_B))\n\n    # ── Seeds ─────────────────────────────────────────────────────────────────\n    seed_A = seeds.get(teamA, 16); seed_B = seeds.get(teamB, 16)\n    if pd.isna(seed_A): seed_A = 16\n    if pd.isna(seed_B): seed_B = 16\n    seed_A, seed_B = int(seed_A), int(seed_B)\n    feat['SeedDiff']  = seed_A - seed_B\n    feat['SeedA']     = seed_A\n    feat['SeedB']     = seed_B\n\n    # Seed interaction: historical win rate for this seed matchup\n    s_lo, s_hi = min(seed_A, seed_B), max(seed_A, seed_B)\n    hist_rate  = seed_history.get((s_lo, s_hi), 0.5)\n    # hist_rate = P(lower seed wins); flip if teamA is the higher seed\n    feat['SeedHistWinProb'] = hist_rate if seed_A <= seed_B else (1 - hist_rate)\n\n    # Upset-line dummies (5v12, 8v9, etc.)\n    for a, b in [(1,16),(2,15),(3,14),(4,13),(5,12),(6,11),(7,10),(8,9)]:\n        feat[f'IsLine_{a}v{b}'] = 1 if (s_lo == a and s_hi == b) else 0\n\n    # ── Basic stats ───────────────────────────────────────────────────────────\n    for col in ['WinPct','AvgPtDiff','RecentWinPct','AvgPtsFor','AvgPtsAgainst']:\n        a, b = gs(teamA, col), gs(teamB, col)\n        feat[f'{col}Diff'] = a - b\n        feat[f'{col}_A']   = a\n        feat[f'{col}_B']   = b\n\n    # ── KenPom Four Factors ───────────────────────────────────────────────────\n    for col in ['eFGpct','TOVpct','ORBpct','FTR','FTpct',\n                'def_eFGpct','def_TOVpct','def_FTR',\n                'OffEff','DefEff','AdjEM','Pace']:\n        a, b = gf(teamA, col), gf(teamB, col)\n        feat[f'{col}Diff'] = a - b\n        feat[f'{col}_A']   = a\n        feat[f'{col}_B']   = b\n\n    # ── Massey ordinals ───────────────────────────────────────────────────────\n    mA = massey.get(teamA, {}).get('MasseyMean', 200)\n    mB = massey.get(teamB, {}).get('MasseyMean', 200)\n    feat['MasseyRankDiff'] = mA - mB  # positive = A is ranked worse\n\n    # ── SOS ───────────────────────────────────────────────────────────────────\n    feat['SOSDiff'] = sos.get(teamA, 1500) - sos.get(teamB, 1500)\n\n    feat['Season'] = season\n    feat['TeamA']  = teamA\n    feat['TeamB']  = teamB\n    feat['Label']  = label\n    return feat\n\n\nprint('Feature builder v2 defined ✓')","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 9. Build Season Lookups & Training Data","metadata":{}},{"cell_type":"code","source":"TRAIN_SEASONS = list(range(2003, TARGET_SEASON))\n\ndef build_all_lookups(reg_compact, reg_detail, tourn_compact, tourn_detail,\n                       seeds_df, massey_df, elo_by_season, seasons):\n    stats_bys  = {}\n    bt_bys     = {}\n    seeds_bys  = {}\n    massey_bys = {}\n    sos_bys    = {}\n    ff_bys     = {}\n\n    for s in seasons:\n        try: stats_bys[s] = compute_team_stats(reg_compact, s)\n        except: stats_bys[s] = pd.DataFrame()\n\n        try: bt_bys[s] = get_bt_for_season(reg_compact, tourn_compact, s)\n        except: bt_bys[s] = {}\n\n        s_seeds = seeds_df[seeds_df['Season'] == s] if len(seeds_df) > 0 else pd.DataFrame()\n        seeds_bys[s] = {int(r['TeamID']): parse_seed(r['Seed']) for _, r in s_seeds.iterrows()}\n\n        massey_bys[s] = get_massey_features(massey_df, s)\n\n        elo_prev = elo_by_season.get(s, {})\n        sos_bys[s] = compute_sos(reg_compact, elo_prev, s)\n\n        try: ff_bys[s] = compute_four_factors(reg_detail, tourn_detail, s)\n        except: ff_bys[s] = pd.DataFrame()\n\n    return stats_bys, bt_bys, seeds_bys, massey_bys, sos_bys, ff_bys\n\n\nprint('Building men\\'s lookups (all seasons)...')\n(m_stats_bys, m_bt_bys, m_seeds_bys,\n m_massey_bys, m_sos_bys, m_ff_bys) = build_all_lookups(\n    m_reg_compact, m_reg_detail, m_tourn_compact, m_tourn_detail,\n    m_seeds, m_massey, m_elo_by_season, TRAIN_SEASONS)\n\nprint('Building women\\'s lookups (all seasons)...')\n(w_stats_bys, w_bt_bys, w_seeds_bys,\n w_massey_bys, w_sos_bys, w_ff_bys) = build_all_lookups(\n    w_reg_compact, w_reg_detail, w_tourn_compact, w_tourn_detail,\n    w_seeds, w_massey, w_elo_by_season, TRAIN_SEASONS)\n\nprint('Season lookups done ✓')","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def build_training_data(tourn_compact, stats_bys, elo_bys, bt_bys, seeds_bys,\n                         massey_bys, sos_bys, ff_bys, seed_history):\n    rows = []\n    for _, row in tourn_compact.iterrows():\n        s = int(row['Season'])\n        if s not in stats_bys: continue\n        feat = build_matchup_features(\n            row, stats_bys, elo_bys, bt_bys, seeds_bys,\n            massey_bys, sos_bys, ff_bys, seed_history)\n        rows.append(feat)\n    return pd.DataFrame(rows)\n\n\nprint('Building training data...')\nm_train = build_training_data(\n    m_tourn_compact, m_stats_bys, m_elo_by_season, m_bt_bys,\n    m_seeds_bys, m_massey_bys, m_sos_bys, m_ff_bys, m_seed_history)\n\nw_train = build_training_data(\n    w_tourn_compact, w_stats_bys, w_elo_by_season, w_bt_bys,\n    w_seeds_bys, w_massey_bys, w_sos_bys, w_ff_bys, w_seed_history)\n\nprint(f'Men\\'s training rows:   {len(m_train)}')\nprint(f'Women\\'s training rows: {len(w_train)}')\n\nMETA_COLS    = ['Season', 'TeamA', 'TeamB', 'Label']\nFEATURE_COLS = [c for c in m_train.columns if c not in META_COLS]\nprint(f'Features: {len(FEATURE_COLS)}')","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 10. Separate Men's / Women's Models\n\n**Improvement:** Train independent XGB + LGB models for each gender. Women's basketball has very different dynamics (dominant programs, seeding patterns, scoring pace).","metadata":{}},{"cell_type":"code","source":"def get_XY(df, feature_cols):\n    X = df[feature_cols].fillna(0).astype(float).values\n    y = df['Label'].values\n    return X, y\n\n\ndef train_models(train_df, feature_cols, label=''):\n    X, y = get_XY(train_df, feature_cols)\n\n    # Logistic Regression\n    lr = Pipeline([\n        ('sc', StandardScaler()),\n        ('lr', LogisticRegression(C=0.1, max_iter=1000, random_state=SEED))\n    ])\n    lr_cv = -cross_val_score(lr, X, y, cv=5, scoring='neg_brier_score').mean()\n    lr.fit(X, y)\n\n    # XGBoost\n    xgb_m = xgb.XGBClassifier(\n        n_estimators=600, max_depth=4, learning_rate=0.04,\n        subsample=0.8, colsample_bytree=0.7, min_child_weight=3,\n        reg_alpha=0.1, reg_lambda=1.5,\n        eval_metric='logloss', random_state=SEED, n_jobs=-1,\n        use_label_encoder=False\n    )\n    xgb_cv = -cross_val_score(xgb_m, X, y, cv=5, scoring='neg_brier_score').mean()\n    xgb_m.fit(X, y)\n\n    # LightGBM\n    lgb_m = lgb.LGBMClassifier(\n        n_estimators=600, max_depth=4, learning_rate=0.04,\n        num_leaves=15, subsample=0.8, colsample_bytree=0.7,\n        min_child_samples=10, reg_alpha=0.1, reg_lambda=1.5,\n        random_state=SEED, n_jobs=-1, verbose=-1\n    )\n    lgb_cv = -cross_val_score(lgb_m, X, y, cv=5, scoring='neg_brier_score').mean()\n    lgb_m.fit(X, y)\n\n    print(f'{label} CV Brier — LR: {lr_cv:.4f}  XGB: {xgb_cv:.4f}  LGB: {lgb_cv:.4f}')\n    return lr, xgb_m, lgb_m\n\n\nprint('Training Men\\'s models...')\nm_lr, m_xgb, m_lgb = train_models(m_train, FEATURE_COLS, \"Men's\")\n\nprint('Training Women\\'s models...')\n# Women's may have fewer features populated — use same feature_cols (zeros for missing)\nw_lr, w_xgb, w_lgb = train_models(w_train, FEATURE_COLS, \"Women's\")\n\nprint('Models trained ✓')","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 11. Optuna Ensemble Weight Optimization\n\n**Improvement:** Instead of hand-picked weights, use Bayesian optimization to find the weight combination (LR, XGB, LGB, Elo, BT) that minimizes Brier score on held-out seasons 2018–2025.","metadata":{}},{"cell_type":"code","source":"WEIGHT_VAL_SEASONS = list(range(2018, TARGET_SEASON))  # held-out for weight tuning\n\ndef get_val_predictions(tourn_compact, stats_bys, elo_bys, bt_bys, seeds_bys,\n                         massey_bys, sos_bys, ff_bys, seed_history,\n                         lr_m, xgb_m, lgb_m, feature_cols, val_seasons):\n    \"\"\"Return dict of model predictions + labels for validation seasons.\"\"\"\n    all_p_lr, all_p_xgb, all_p_lgb, all_p_elo, all_p_bt, all_y = [], [], [], [], [], []\n\n    for _, row in tourn_compact[tourn_compact['Season'].isin(val_seasons)].iterrows():\n        s = int(row['Season'])\n        if s not in stats_bys: continue\n        feat = build_matchup_features(\n            row, stats_bys, elo_bys, bt_bys, seeds_bys,\n            massey_bys, sos_bys, ff_bys, seed_history)\n\n        x = np.array([feat.get(c, 0.0) for c in feature_cols], dtype=float).reshape(1, -1)\n        all_p_lr.append(lr_m.predict_proba(x)[0, 1])\n        all_p_xgb.append(xgb_m.predict_proba(x)[0, 1])\n        all_p_lgb.append(lgb_m.predict_proba(x)[0, 1])\n\n        elo_A = elo_bys.get(s, {}).get(feat['TeamA'], 1500)\n        elo_B = elo_bys.get(s, {}).get(feat['TeamB'], 1500)\n        all_p_elo.append(1 / (1 + 10 ** ((elo_B - elo_A) / 400)))\n\n        bt   = bt_bys.get(s, {})\n        bt_A = bt.get(feat['TeamA'], 0.0)\n        bt_B = bt.get(feat['TeamB'], 0.0)\n        all_p_bt.append(float(expit(bt_A - bt_B)))\n\n        all_y.append(feat['Label'])\n\n    return (np.array(all_p_lr), np.array(all_p_xgb), np.array(all_p_lgb),\n            np.array(all_p_elo), np.array(all_p_bt), np.array(all_y))\n\n\nprint('Computing validation predictions for Men\\'s...')\nm_val = get_val_predictions(\n    m_tourn_compact, m_stats_bys, m_elo_by_season, m_bt_bys,\n    m_seeds_bys, m_massey_bys, m_sos_bys, m_ff_bys, m_seed_history,\n    m_lr, m_xgb, m_lgb, FEATURE_COLS, WEIGHT_VAL_SEASONS)\n\nprint('Computing validation predictions for Women\\'s...')\nw_val = get_val_predictions(\n    w_tourn_compact, w_stats_bys, w_elo_by_season, w_bt_bys,\n    w_seeds_bys, w_massey_bys, w_sos_bys, w_ff_bys, w_seed_history,\n    w_lr, w_xgb, w_lgb, FEATURE_COLS, WEIGHT_VAL_SEASONS)\n\nprint(f'Val games — Men\\'s: {len(m_val[0])}, Women\\'s: {len(w_val[0])} ✓')","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def optimize_weights(val_preds, n_trials=200, label=''):\n    \"\"\"\n    Find optimal ensemble weights via Optuna (or grid search fallback).\n    val_preds = (p_lr, p_xgb, p_lgb, p_elo, p_bt, y_true)\n    Returns (w_lr, w_xgb, w_lgb, w_elo, w_bt)\n    \"\"\"\n    p_lr, p_xgb, p_lgb, p_elo, p_bt, y = val_preds\n\n    def objective(weights):\n        w = np.array(weights)\n        w = w / w.sum()  # normalize\n        p = clip_prob(w[0]*p_lr + w[1]*p_xgb + w[2]*p_lgb + w[3]*p_elo + w[4]*p_bt)\n        return brier_score(y, p)\n\n    if HAS_OPTUNA:\n        def optuna_obj(trial):\n            w = [trial.suggest_float(f'w{i}', 0.0, 1.0) for i in range(5)]\n            return objective(w)\n\n        study = optuna.create_study(direction='minimize',\n                                     sampler=optuna.samplers.TPESampler(seed=SEED))\n        study.optimize(optuna_obj, n_trials=n_trials, show_progress_bar=False)\n        best = [study.best_params[f'w{i}'] for i in range(5)]\n    else:\n        # Grid search fallback\n        best_score = np.inf\n        best = [0.1, 0.35, 0.35, 0.1, 0.1]\n        for w_lr in [0.05, 0.1, 0.15, 0.2]:\n            for w_xgb in [0.25, 0.30, 0.35, 0.40]:\n                for w_lgb in [0.25, 0.30, 0.35, 0.40]:\n                    for w_elo in [0.05, 0.10, 0.15]:\n                        w_bt = max(0, 1 - w_lr - w_xgb - w_lgb - w_elo)\n                        score = objective([w_lr, w_xgb, w_lgb, w_elo, w_bt])\n                        if score < best_score:\n                            best_score = score\n                            best = [w_lr, w_xgb, w_lgb, w_elo, w_bt]\n\n    w_arr = np.array(best) / np.sum(best)\n    final_brier = objective(best)\n    print(f'{label} optimal weights: LR={w_arr[0]:.3f} XGB={w_arr[1]:.3f} '\n          f'LGB={w_arr[2]:.3f} Elo={w_arr[3]:.3f} BT={w_arr[4]:.3f}')\n    print(f'{label} val Brier: {final_brier:.4f} '\n          f'(naive 0.5: {brier_score(val_preds[5], np.full(len(val_preds[5]), 0.5)):.4f})')\n    return tuple(w_arr)\n\n\nprint('Optimizing weights for Men\\'s...')\nm_weights = optimize_weights(m_val, n_trials=300, label=\"Men's\")\n\nprint('Optimizing weights for Women\\'s...')\nw_weights = optimize_weights(w_val, n_trials=300, label=\"Women's\")\n\nprint('Weight optimization done ✓')","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 12. Isotonic Calibration\n\n**Improvement:** Fit isotonic regression on ensemble outputs to ensure probabilities are well-calibrated. This reduces Brier score by correcting systematic over/under-confidence.","metadata":{}},{"cell_type":"code","source":"def make_ensemble(val_preds, weights):\n    p_lr, p_xgb, p_lgb, p_elo, p_bt, y = val_preds\n    w = np.array(weights)\n    return clip_prob(w[0]*p_lr + w[1]*p_xgb + w[2]*p_lgb + w[3]*p_elo + w[4]*p_bt)\n\n\nm_ens_val = make_ensemble(m_val, m_weights)\nw_ens_val = make_ensemble(w_val, w_weights)\n\n# Fit isotonic regression calibrators on validation predictions\nm_iso = IsotonicRegression(out_of_bounds='clip')\nm_iso.fit(m_ens_val, m_val[5])\n\nw_iso = IsotonicRegression(out_of_bounds='clip')\nw_iso.fit(w_ens_val, w_val[5])\n\n# Check calibration improves Brier\nm_cal_val = clip_prob(m_iso.predict(m_ens_val))\nw_cal_val = clip_prob(w_iso.predict(w_ens_val))\n\nprint(f\"Men's   — pre-cal: {brier_score(m_val[5], m_ens_val):.4f}  \"\n      f\"post-cal: {brier_score(m_val[5], m_cal_val):.4f}\")\nprint(f\"Women's — pre-cal: {brier_score(w_val[5], w_ens_val):.4f}  \"\n      f\"post-cal: {brier_score(w_val[5], w_cal_val):.4f}\")\nprint('Isotonic calibration fitted ✓')","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 13. Build 2026 Lookups & Generate Submission","metadata":{}},{"cell_type":"code","source":"# 2026 seeds\nm_seeds_2026 = {int(r['TeamID']): parse_seed(r['Seed'])\n                for _, r in m_seeds[m_seeds['Season'] == TARGET_SEASON].iterrows()}\nw_seeds_2026 = {int(r['TeamID']): parse_seed(r['Seed'])\n                for _, r in w_seeds[w_seeds['Season'] == TARGET_SEASON].iterrows()}\n\n# 2026 stats/Elo/BT (already computed)\nm_stats_2026 = compute_team_stats(m_reg_compact, TARGET_SEASON)\nw_stats_2026 = compute_team_stats(w_reg_compact, TARGET_SEASON)\nm_elo_2026   = m_elo_by_season.get(TARGET_SEASON, {})\nw_elo_2026   = w_elo_by_season.get(TARGET_SEASON, {})\nm_sos_2026   = compute_sos(m_reg_compact, m_elo_by_season.get(TARGET_SEASON-1, {}), TARGET_SEASON)\nw_sos_2026   = compute_sos(w_reg_compact, w_elo_by_season.get(TARGET_SEASON-1, {}), TARGET_SEASON)\nm_massey_2026= get_massey_features(m_massey, TARGET_SEASON)\nw_massey_2026= get_massey_features(w_massey, TARGET_SEASON)\n\nprint('2026 lookups built ✓')\nprint(f\"  Men's Elo teams: {len(m_elo_2026)}, seeds: {len(m_seeds_2026)}\")\nprint(f\"  Women's Elo teams: {len(w_elo_2026)}, seeds: {len(w_seeds_2026)}\")","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def predict_submission_v2(sample_sub,\n                           m_stats, m_elo, m_bt, m_seeds, m_massey, m_sos, m_ff,\n                           w_stats, w_elo, w_bt, w_seeds, w_massey, w_sos, w_ff,\n                           m_lr, m_xgb, m_lgb, m_weights, m_iso, m_seed_hist,\n                           w_lr, w_xgb, w_lgb, w_weights, w_iso, w_seed_hist,\n                           feature_cols):\n    rows = []\n\n    for _, row in sample_sub.iterrows():\n        parts   = row['ID'].split('_')\n        season  = int(parts[0])\n        team_a  = int(parts[1])\n        team_b  = int(parts[2])\n        is_w    = (team_a >= 3000)\n\n        # Select gender-specific lookups\n        stats_d  = {season: w_stats  if is_w else m_stats}\n        elo_d    = {season: w_elo    if is_w else m_elo}\n        bt_d     = {season: w_bt     if is_w else m_bt}\n        seeds_d  = {season: w_seeds  if is_w else m_seeds}\n        massey_d = {season: w_massey if is_w else m_massey}\n        sos_d    = {season: w_sos    if is_w else m_sos}\n        ff_d     = {season: w_ff     if is_w else m_ff}\n        sh       = w_seed_hist if is_w else m_seed_hist\n        lr_m     = w_lr  if is_w else m_lr\n        xgb_m    = w_xgb if is_w else m_xgb\n        lgb_m    = w_lgb if is_w else m_lgb\n        iso      = w_iso if is_w else m_iso\n        weights  = w_weights if is_w else m_weights\n        elo_flat = w_elo if is_w else m_elo\n        bt_flat  = w_bt  if is_w else m_bt\n\n        fake_row = pd.Series({\n            'Season': season, 'WTeamID': team_a, 'LTeamID': team_b,\n            'WScore': 70, 'LScore': 65\n        })\n\n        feat = build_matchup_features(\n            fake_row, stats_d, elo_d, bt_d, seeds_d, massey_d, sos_d, ff_d, sh)\n\n        x = np.array([feat.get(c, 0.0) for c in feature_cols], dtype=float).reshape(1, -1)\n\n        p_lr_  = lr_m.predict_proba(x)[0, 1]\n        p_xgb_ = xgb_m.predict_proba(x)[0, 1]\n        p_lgb_ = lgb_m.predict_proba(x)[0, 1]\n\n        elo_a = elo_flat.get(team_a, 1500)\n        elo_b = elo_flat.get(team_b, 1500)\n        p_elo_ = 1 / (1 + 10 ** ((elo_b - elo_a) / 400))\n\n        bt_a = bt_flat.get(team_a, 0.0)\n        bt_b = bt_flat.get(team_b, 0.0)\n        p_bt_ = float(expit(bt_a - bt_b))\n\n        w = np.array(weights)\n        p_ens = clip_prob(w[0]*p_lr_ + w[1]*p_xgb_ + w[2]*p_lgb_ + w[3]*p_elo_ + w[4]*p_bt_)\n\n        # Isotonic calibration\n        p_final = float(clip_prob(iso.predict([p_ens])[0]))\n\n        rows.append({'ID': row['ID'], 'Pred': p_final})\n\n    return pd.DataFrame(rows)\n\n\nprint('Generating final predictions...')\nsubmission = predict_submission_v2(\n    sample_sub,\n    m_stats_2026, m_elo_2026, m_bt, m_seeds_2026, m_massey_2026, m_sos_2026, m_ff_2026,\n    w_stats_2026, w_elo_2026, w_bt, w_seeds_2026, w_massey_2026, w_sos_2026, w_ff_2026,\n    m_lr, m_xgb, m_lgb, m_weights, m_iso, m_seed_history,\n    w_lr, w_xgb, w_lgb, w_weights, w_iso, w_seed_history,\n    FEATURE_COLS\n)\n\nprint(f'Submission shape: {submission.shape}')\nprint(f'Pred range: {submission[\"Pred\"].min():.4f} – {submission[\"Pred\"].max():.4f}')\nprint(f'Pred mean:  {submission[\"Pred\"].mean():.4f}')\nsubmission.head(10)","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 14. Sanity Checks","metadata":{}},{"cell_type":"code","source":"import matplotlib.pyplot as plt\n\nsub_m = submission[submission['ID'].str.split('_').str[1].astype(int) < 3000]\nsub_w = submission[submission['ID'].str.split('_').str[1].astype(int) >= 3000]\n\nfig, axes = plt.subplots(1, 3, figsize=(16, 4))\n\nsubmission['Pred'].hist(bins=50, ax=axes[0], color='steelblue', edgecolor='white')\naxes[0].set_title('All predictions')\naxes[0].set_xlabel('P(LowID wins)')\n\nsub_m['Pred'].hist(bins=40, ax=axes[1], color='royalblue', edgecolor='white')\naxes[1].set_title(\"Men's predictions\")\n\nsub_w['Pred'].hist(bins=40, ax=axes[2], color='salmon', edgecolor='white')\naxes[2].set_title(\"Women's predictions\")\n\nplt.tight_layout()\nplt.savefig(OUT_DIR / 'prediction_dist_v2.png', dpi=120)\nplt.show()\n\nprint(f\"Men's matchups:   {len(sub_m):,}\")\nprint(f\"Women's matchups: {len(sub_w):,}\")\nprint(f\"NaN predictions:  {submission['Pred'].isna().sum()}\")\nassert submission['Pred'].isna().sum() == 0, 'NaN predictions found!'\nprint('Sanity checks passed ✓')","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Feature importance (Men's XGB)\nimp = pd.Series(m_xgb.feature_importances_, index=FEATURE_COLS).sort_values(ascending=False)\n\nfig, ax = plt.subplots(figsize=(10, 7))\nimp.head(25).plot(kind='barh', ax=ax, color='steelblue')\nax.set_title(\"Men's XGB — Top 25 Feature Importances\")\nax.invert_yaxis()\nplt.tight_layout()\nplt.savefig(OUT_DIR / 'feature_importance_v2.png', dpi=120)\nplt.show()","metadata":{},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 15. Save Submission","metadata":{}},{"cell_type":"code","source":"out_path = OUT_DIR / 'submission.csv'\nsubmission.to_csv(out_path, index=False)\nprint(f'Saved → {out_path}')\nprint(submission.describe())","metadata":{},"outputs":[],"execution_count":null}]}
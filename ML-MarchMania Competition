    "def fit_bradley_terry(games_df, team_ids, n_iter=500, tol=1e-6):\n",
    "    teams = list(team_ids)\n",
    "    idx   = {t: i for i, t in enumerate(teams)}\n",
    "    n     = len(teams)\n",
    "    wins  = np.zeros((n, n))\n",
    "    games = np.zeros((n, n))\n",
    "\n",
    "    for _, row in games_df.iterrows():\n",
    "        w, l = int(row['WTeamID']), int(row['LTeamID'])\n",
    "        if w not in idx or l not in idx: continue\n",
    "        i, j = idx[w], idx[l]\n",
    "        wins[i, j]  += 1\n",
    "        games[i, j] += 1\n",
    "        games[j, i] += 1\n",
    "\n",
    "    p = np.ones(n)\n",
    "    for _ in range(n_iter):\n",
    "        p_old = p.copy()\n",
    "        W     = wins.sum(axis=1)\n",
    "        denom = np.zeros(n)\n",
    "        for i in range(n):\n",
    "            for j in range(n):\n",
    "                if games[i, j] > 0:\n",
    "                    denom[i] += games[i, j] / (p[i] + p[j])\n",
    "        p = W / (denom + 1e-10)\n",
    "        p /= p.mean()\n",
    "        if np.max(np.abs(p - p_old)) < tol: break\n",
    "\n",
    "    return {teams[i]: np.log(p[i] + 1e-10) for i in range(n)}\n",
    "\n",
    "\n",
    "def get_bt_for_season(reg_df, tourn_df, season):\n",
    "    reg_s        = reg_df[reg_df['Season'] == season]\n",
    "    tourn_prior  = tourn_df[tourn_df['Season'] < season]\n",
    "    games        = pd.concat([reg_s, tourn_prior], ignore_index=True)\n",
    "    team_ids     = set(games['WTeamID']).union(set(games['LTeamID']))\n",
    "    return fit_bradley_terry(games, team_ids)\n",
    "\n",
    "\n",
    "print('Fitting BT for Men\\'s...')\n",
    "m_bt = get_bt_for_season(m_reg_compact, m_tourn_compact, TARGET_SEASON)\n",
    "print('Fitting BT for Women\\'s...')\n",
    "w_bt = get_bt_for_season(w_reg_compact, w_tourn_compact, TARGET_SEASON)\n",
    "print(f'BT done — {len(m_bt)} men\\'s, {len(w_bt)} women\\'s teams ✓')"

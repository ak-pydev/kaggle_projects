    "REGULAR_SEASON_END_DAY = 118  # approx last day before conference tourneys\n",
    "RECENCY_WINDOW = 30           # days before end of regular season to boost\n",
    "RECENCY_K_MULT = 2.0          # K multiplier for recent games\n",
    "\n",
    "def compute_elo(games_df, initial_elo=1500, K=20, carry_over=0.75, margin_weight=True):\n",
    "    \"\"\"\n",
    "    Elo with:\n",
    "    - Margin-of-victory K scaling (538/Silver style)\n",
    "    - Recency decay: late-season games count 2x\n",
    "    - Season carry-over with regression to mean\n",
    "    \"\"\"\n",
    "    elo = {}\n",
    "    season_end_elo = {}\n",
    "\n",
    "    games_sorted = games_df.sort_values(['Season', 'DayNum']).reset_index(drop=True)\n",
    "    current_season = None\n",
    "\n",
    "    for _, row in games_sorted.iterrows():\n",
    "        season  = int(row['Season'])\n",
    "        day_num = int(row['DayNum'])\n",
    "\n",
    "        if season != current_season:\n",
    "            if current_season is not None:\n",
    "                season_end_elo[current_season] = dict(elo)\n",
    "                for tid in elo:\n",
    "                    elo[tid] = carry_over * elo[tid] + (1 - carry_over) * initial_elo\n",
    "            current_season = season\n",
    "\n",
    "        w = int(row['WTeamID'])\n",
    "        l = int(row['LTeamID'])\n",
    "        ws = float(row['WScore']) if 'WScore' in row.index and pd.notna(row['WScore']) else 0.0\n",
    "        ls = float(row['LScore']) if 'LScore' in row.index and pd.notna(row['LScore']) else 0.0\n",
    "\n",
    "        elo.setdefault(w, initial_elo)\n",
    "        elo.setdefault(l, initial_elo)\n",
    "\n",
    "        ew, el_ = elo[w], elo[l]\n",
    "        exp_w = 1.0 / (1.0 + 10.0 ** ((el_ - ew) / 400.0))\n",
    "\n",
    "        # Base K\n",
    "        k = float(K)\n",
    "\n",
    "        # MOV multiplier\n",
    "        if margin_weight and ws > 0 and ls > 0:\n",
    "            mov      = abs(ws - ls)\n",
    "            elo_diff = abs(ew - el_)\n",
    "            k *= np.log1p(mov) * (2.2 / (elo_diff * 0.001 + 2.2))\n",
    "\n",
    "        # Recency boost for late regular season & tournament games\n",
    "        if day_num >= (REGULAR_SEASON_END_DAY - RECENCY_WINDOW):\n",
    "            k *= RECENCY_K_MULT\n",
    "\n",
    "        elo[w] += k * (1.0 - exp_w)\n",
    "        elo[l] += k * (0.0 - (1.0 - exp_w))\n",
    "\n",
    "    if current_season is not None:\n",
    "        season_end_elo[current_season] = dict(elo)\n",
    "\n",
    "    return season_end_elo\n",
    "\n",
    "\n",
    "m_all_games = safe_concat([m_reg_compact, m_tourn_compact])\n",
    "w_all_games = safe_concat([w_reg_compact, w_tourn_compact])\n",
    "\n",
    "m_elo_by_season = compute_elo(m_all_games, K=20)\n",
    "w_elo_by_season = compute_elo(w_all_games, K=20)\n",
    "\n",
    "display_season = TARGET_SEASON if TARGET_SEASON in m_elo_by_season else max(m_elo_by_season)\n",
    "top = sorted(m_elo_by_season[display_season].items(), key=lambda x: -x[1])[:10]\n",

    "def build_seed_history(tourn_compact, seeds_df):\n",
    "    \"\"\"\n",
    "    Compute historical win rate for each (seed_low, seed_high) matchup pair.\n",
    "    Returns dict: (seed_a, seed_b) → P(seed_a wins), where seed_a < seed_b numerically.\n",
    "    \"\"\"\n",
    "    seeds_map = {}\n",
    "    for _, r in seeds_df.iterrows():\n",
    "        seeds_map[(int(r['Season']), int(r['TeamID']))] = parse_seed(r['Seed'])\n",
    "\n",
    "    matchup_wins  = {}\n",
    "    matchup_total = {}\n",
    "\n",
    "    for _, r in tourn_compact.iterrows():\n",
    "        s  = int(r['Season'])\n",
    "        wt = int(r['WTeamID'])\n",
    "        lt = int(r['LTeamID'])\n",
    "        sw = seeds_map.get((s, wt), 16)\n",
    "        sl = seeds_map.get((s, lt), 16)\n",
    "        if pd.isna(sw) or pd.isna(sl): continue\n",
    "        sw, sl = int(sw), int(sl)\n",
    "\n",
    "        # Canonical: lower seed number = better seed\n",
    "        key = (min(sw, sl), max(sw, sl))\n",
    "        matchup_total[key] = matchup_total.get(key, 0) + 1\n",
    "        # Did the lower (better) seed win?\n",
    "        if sw < sl:  # winner had better seed\n",
    "            matchup_wins[key] = matchup_wins.get(key, 0) + 1\n",
    "\n",
    "    hist = {}\n",
    "    for key, total in matchup_total.items():\n",
    "        wins = matchup_wins.get(key, 0)\n",
    "        # Laplace smoothing with prior of 0.5\n",
    "        hist[key] = (wins + 2) / (total + 4)\n",
    "\n",
    "    return hist\n",
    "\n",
    "\n",
    "m_seed_history = build_seed_history(m_tourn_compact, m_seeds)\n",
    "w_seed_history = build_seed_history(w_tourn_compact, w_seeds)\n",
    "\n",
    "# Show classic upsets\n",
    "upset_lines = [(5,12),(6,11),(7,10),(8,9),(1,16),(2,15),(3,14),(4,13)]\n",
    "print('Historical upset rates (men\\'s):')\n",
    "for a, b in upset_lines:\n",
